diff --git a/arch/wasm/include/asm/park.h b/arch/wasm/include/asm/park.h
new file mode 100644
index 00000000000..2aa5ffd70d1
--- /dev/null
+++ b/arch/wasm/include/asm/park.h
@@ -0,0 +1,32 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#ifndef _ASM_WASM_PARK_H
+#define _ASM_WASM_PARK_H
+
+#include <linux/compiler.h>
+#include <linux/linkage.h>
+
+/* thread_struct.park_state */
+#define KW_PARK_NONE		0
+#define KW_PARK_PARKED		1	/* asleep in kw_park_self(), stack not needed */
+#define KW_PARK_RESUMING	2	/* resumes in kw_park_resume() on a fresh stack */
+
+struct task_struct;
+
+/* Set while user tasks are asked to park at the top of user_mode_loop(). */
+extern int kw_park_users;
+/* Set once every task but the idle tasks is parked: arch_cpu_idle() finishes. */
+extern int kw_park_final;
+
+/* Request a park cycle (any context). */
+void kw_park_request(void);
+/* user_mode_loop(), interrupts disabled: park this user task. */
+void kw_park_user(void);
+/* __ret_from_fork() of a task whose park_state is KW_PARK_RESUMING. */
+void __noreturn kw_park_resume(struct task_struct *prev);
+/* arch_cpu_idle(), within irqentry_enter(), once kw_park_final is set. */
+void kw_park_idle(void);
+/* kw_resume (entry.S): a restored snapshot starts here. */
+asmlinkage void __noreturn __kw_resume(void);
+
+#endif /* _ASM_WASM_PARK_H */
diff --git a/arch/wasm/include/asm/processor.h b/arch/wasm/include/asm/processor.h
index 648e1c367b3..da9befa9706 100644
--- a/arch/wasm/include/asm/processor.h
+++ b/arch/wasm/include/asm/processor.h
@@ -30,6 +30,10 @@ struct pt_regs;
 struct thread_struct {
 	int (*fn)(void *);	/* kernel thread entry (until first run) */
 	void *fn_arg;
+	/* Parking (kernel/park.c): how the task resumes on a fresh stack. */
+	int (*park_fn)(void *);	/* kernel thread: re-enters its loop */
+	void *park_arg;
+	int park_state;		/* KW_PARK_* (asm/park.h) */
 };
 
 #define INIT_THREAD { }
diff --git a/arch/wasm/include/asm/wasm.h b/arch/wasm/include/asm/wasm.h
index d78af949ec5..f317d3f6710 100644
--- a/arch/wasm/include/asm/wasm.h
+++ b/arch/wasm/include/asm/wasm.h
@@ -53,6 +53,19 @@ void __init wasm_load_initrd(void);
 void wasm_dump_stacktrace(char *buffer, unsigned long max_size)
 	__unkernel_import(wasm_dump_stacktrace);
 
+/*
+ * A snapshot the host asked for (WASM_IRQ_SNAPSHOT) reached its end:
+ * result 0 means every task is parked and this is the consistent point
+ * (park.c), where the host copies the memory during the call; otherwise
+ * it is the error, with @blocker naming the task that did not park. At
+ * the consistent point, @free_map (or NULL) has a bit set for each free
+ * pfn below @free_bits, pages the host may leave out (they restore as
+ * zeros). The host returns 0 if it saved the snapshot, or a negative errno.
+ */
+int wasm_snapshot_point(int result, const char *blocker,
+			const unsigned long *free_map, unsigned long free_bits)
+	__unkernel_import(wasm_snapshot_point);
+
 /*
  * Console window size, rows << 16 | cols, or 0 if unknown. hvc_wasm reads it
  * when the tty is opened and on each input poll; the host raises
