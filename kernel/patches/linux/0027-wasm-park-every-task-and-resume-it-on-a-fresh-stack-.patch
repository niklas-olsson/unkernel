 	bool
 
+# Parking every task on demand (arch/wasm/kernel/park.c, linux/kw_park.h).
+config KW_PARK
+	def_bool y
+
 config 64BIT
 	def_bool y
 
diff --git a/arch/wasm/include/asm/irq.h b/arch/wasm/include/asm/irq.h
index 97330d57a21..8614e54fe17 100644
--- a/arch/wasm/include/asm/irq.h
+++ b/arch/wasm/include/asm/irq.h
@@ -13,7 +13,9 @@
