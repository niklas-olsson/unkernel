 arch/wasm/include/asm/irq.h       |   2 +
 arch/wasm/include/asm/park.h      |  32 ++
 arch/wasm/include/asm/processor.h |   4 +
 arch/wasm/include/asm/wasm.h      |  13 +
 arch/wasm/kernel/Makefile         |   1 +
 arch/wasm/kernel/entry.S          |  20 ++
 arch/wasm/kernel/irq.c            |  12 +
 arch/wasm/kernel/park.c           | 510 ++++++++++++++++++++++++++++++
 arch/wasm/kernel/process.c        |  12 +-
 arch/wasm/kernel/traps.c          |   8 +
 11 files changed, 617 insertions(+), 1 deletion(-)
 create mode 100644 arch/wasm/include/asm/park.h
 create mode 100644 arch/wasm/kernel/park.c

diff --git a/arch/wasm/Kconfig b/arch/wasm/Kconfig
index a84bec4a18a..1ed6743adce 100644
--- a/arch/wasm/Kconfig
+++ b/arch/wasm/Kconfig
@@ -46,6 +46,10 @@ config MMU
