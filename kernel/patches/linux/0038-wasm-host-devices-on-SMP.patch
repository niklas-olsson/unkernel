index 93059b9670f..9c47827a339 100644
--- a/drivers/input/kwinput.c
+++ b/drivers/input/kwinput.c
@@ -131,6 +131,11 @@ static int __init kwinput_init(void)
 		pr_info("kwinput: no host input\n");
