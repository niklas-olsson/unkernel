From 6e055af643c4e4b34c7046647c82d178adb45f50 Mon Sep 17 00:00:00 2001
From: kernel-wasm <kernel-wasm@localhost>
Date: Mon, 16 Nov 2026 16:07:10 +0000
Subject: [PATCH] wasm: host devices on SMP

The host's device imports answer on CPU 0 alone, and their interrupts
arrive there. hvc_wasm: CPU 0's console interrupt moves the input into
a FIFO and records the window size, which khvcd and openers read on
any CPU (output works everywhere). kwnet: NAPI runs on CPU 0, and
another CPU's frames wait in a queue that a work item on CPU 0 sends;
ndo_open raises the interrupt on CPU 0 instead of looking. kwvsock:
its work items run on CPU 0, and another CPU's packets wait in the
tx queue. kwblk, kwfb, kwinput, kwsnd and kwshm refuse to start on
SMP for now, with a boot message.
---
 drivers/block/kwblk.c      |  8 +++++
 drivers/input/kwinput.c    |  5 +++
 drivers/misc/kwshm.c       |  5 +++
 drivers/net/kwnet.c        | 56 +++++++++++++++++++++++++++--
 drivers/tty/hvc/hvc_wasm.c | 74 ++++++++++++++++++++++++++++++++++++--
 drivers/video/fbdev/kwfb.c |  5 +++
 net/vmw_vsock/kwvsock.c    | 35 +++++++++++++-----
 sound/drivers/kwsnd.c      |  5 +++
 8 files changed, 179 insertions(+), 14 deletions(-)

diff --git a/drivers/block/kwblk.c b/drivers/block/kwblk.c
index 9a0591e9b6c..0b7ca9a6682 100644
--- a/drivers/block/kwblk.c
+++ b/drivers/block/kwblk.c
@@ -251,6 +251,14 @@ static int __init kwblk_init(void)
 	u32 i;
 	int err;
 
+	/* SMP: not yet; its host imports answer on CPU 0 alone, from any context. */
+	if (IS_ENABLED(CONFIG_SMP)) {
+		memset(&info, 0, sizeof(info));
+		if (wasm_driver_block_info(0, &info) >= 0)
+			pr_warn("kwblk: disks are not supported on SMP kernels yet\n");
+		return -ENODEV;
+	}
+
 	kwblk_major = register_blkdev(0, "kwblk");
 	if (kwblk_major < 0)
 		return kwblk_major;
