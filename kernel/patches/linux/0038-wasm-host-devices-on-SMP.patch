 		pr_info("kwfb: no host display\n");
 		return 0;
 	}
+	/* SMP: not yet; its host imports answer on CPU 0 alone, from any context. */
+	if (IS_ENABLED(CONFIG_SMP)) {
+		pr_warn("kwfb: the display is not supported on SMP kernels yet\n");
+		return 0;
+	}
 
 	/*
 	 * A parent on the platform bus: the X.Org fbdev driver skips a
diff --git a/net/vmw_vsock/kwvsock.c b/net/vmw_vsock/kwvsock.c
index 90cb8521bb3..4c088366a0c 100644
--- a/net/vmw_vsock/kwvsock.c
+++ b/net/vmw_vsock/kwvsock.c
@@ -105,6 +105,16 @@ struct kwvsock {
 
 static struct kwvsock kwvsock;
 
+/*
+ * SMP: the host's imports answer on CPU 0 alone, so the work items run
+ * there, and another CPU's packets wait in tx_queue for tx_work.
+ */
+#ifdef CONFIG_SMP
+#define KWVSOCK_CPU	0
+#else
+#define KWVSOCK_CPU	WORK_CPU_UNBOUND
+#endif
+
 static u32 kwvsock_get_local_cid(void)
 {
 	return KWVSOCK_GUEST_CID;
@@ -146,10 +156,18 @@ static int kwvsock_send_pkt(struct sk_buff *skb, struct net *net)
 	int len = skb->len;
 
 	/*
-	 * Straight to the host while nothing waits before it (the kernel is
-	 * UP without preemption, so the check and the send cannot race the
-	 * work item); else in order behind the waiting packets.
+	 * Straight to the host while nothing waits before it (the kernel has
+	 * no preemption, and only CPU 0 sends, so the check and the send
+	 * cannot race the work item); else in order behind the waiting
+	 * packets.
 	 */
+#ifdef CONFIG_SMP
+	if (smp_processor_id()) {
+		virtio_vsock_skb_queue_tail(&kwvsock.tx_queue, skb);
+		queue_work_on(KWVSOCK_CPU, system_percpu_wq, &kwvsock.tx_work);
+		return len;
+	}
+#endif
 	if (skb_queue_empty_lockless(&kwvsock.tx_queue) && kwvsock_xmit(skb))
 		return len;
 	virtio_vsock_skb_queue_tail(&kwvsock.tx_queue, skb);
@@ -243,7 +261,8 @@ static void kwvsock_rx_work(struct work_struct *work)
 		skb = virtio_vsock_alloc_linear_skb(len, GFP_KERNEL);
 		if (!skb) {
 			/* The host keeps the packet: try again a little later. */
-			schedule_delayed_work(&kwvsock.rx_work, msecs_to_jiffies(10));
+			queue_delayed_work_on(KWVSOCK_CPU, system_percpu_wq,
+					      &kwvsock.rx_work, msecs_to_jiffies(10));
 			return;
 		}
 		/* The header lands in the headroom, the payload at skb->data. */
@@ -262,14 +281,14 @@ static void kwvsock_rx_work(struct work_struct *work)
 		virtio_transport_recv_pkt(&kwvsock_transport, skb, NULL);
 	}
 	/* More may be queued: let other work run first. */
-	mod_delayed_work(system_percpu_wq, &kwvsock.rx_work, 0);
+	mod_delayed_work_on(KWVSOCK_CPU, system_percpu_wq, &kwvsock.rx_work, 0);
 }
 
 static irqreturn_t kwvsock_irq(int irq, void *dev_id)
 {
-	mod_delayed_work(system_percpu_wq, &kwvsock.rx_work, 0);
+	mod_delayed_work_on(KWVSOCK_CPU, system_percpu_wq, &kwvsock.rx_work, 0);
 	if (!skb_queue_empty_lockless(&kwvsock.tx_queue))
-		schedule_work(&kwvsock.tx_work);
+		queue_work_on(KWVSOCK_CPU, system_percpu_wq, &kwvsock.tx_work);
 	return IRQ_HANDLED;
 }
 
@@ -328,7 +347,7 @@ static int __init kwvsock_init(void)
 	kw_park_register_restore_notifier(&kwvsock_restore_nb);
 	pr_info("kwvsock: host vsock, guest CID %u\n", KWVSOCK_GUEST_CID);
 	/* Packets may have been queued before the handler existed. */
-	schedule_delayed_work(&kwvsock.rx_work, 0);
+	queue_delayed_work_on(KWVSOCK_CPU, system_percpu_wq, &kwvsock.rx_work, 0);
 	return 0;
 
 err_irq:
