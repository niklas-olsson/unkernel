 	mouse = kwinput_alloc(KWINPUT_MOUSE, "kwinput mouse", 2);
diff --git a/drivers/misc/kwshm.c b/drivers/misc/kwshm.c
index 50ae019a0e9..f1bf8b7cadc 100644
--- a/drivers/misc/kwshm.c
+++ b/drivers/misc/kwshm.c
@@ -629,6 +629,11 @@ static int __init kwshm_init(void)
 		pr_info("kwshm: no host shm\n");
 		return 0;
 	}
+	/* SMP: not yet; its host imports answer on CPU 0 alone, from any context. */
+	if (IS_ENABLED(CONFIG_SMP)) {
+		pr_warn("kwshm: not supported on SMP kernels yet\n");
+		return -ENODEV;
+	}
 	/* Held pages, including truncated ones still held: at most half of RAM. */
 	kwshm_pin_limit = totalram_pages() / 2;
 	INIT_WORK(&kwshm_work, kwshm_work_fn);
diff --git a/drivers/net/kwnet.c b/drivers/net/kwnet.c
index 58d472e593d..3ca58cbfa37 100644
--- a/drivers/net/kwnet.c
+++ b/drivers/net/kwnet.c
@@ -8,6 +8,10 @@
  * the kernel, and in the idle loop), and schedules NAPI, which drains the
  * host queue.
  *
+ * SMP: the host's imports answer on CPU 0 alone. The interrupt, and so
+ * NAPI, runs there; another CPU's frames wait in a queue that a work item
+ * on CPU 0 sends.
+ *
  * The host terminates the link itself (a user-mode TCP/IP stack), so it does
  * not need checksums: the device claims checksum offload and TSO, and marks
  * received frames CHECKSUM_UNNECESSARY.
@@ -19,6 +23,7 @@
 #include <linux/module.h>
 #include <linux/netdevice.h>
 #include <linux/skbuff.h>
+#include <linux/workqueue.h>
 #include <asm/irq.h>
 #include <asm/wasm.h>
 
@@ -45,7 +50,11 @@ MODULE_PARM_DESC(mtu, "initial MTU (default 1500)");
 struct kwnet {
 	struct net_device *dev;
 	struct napi_struct napi;
-	u8 *bounce;			/* TX linearisation buffer */
+	u8 *bounce;			/* TX linearisation buffer (CPU 0) */
+#ifdef CONFIG_SMP
+	struct sk_buff_head txq;	/* frames sent from other CPUs */
+	struct work_struct tx_work;	/* sends them, on CPU 0 */
+#endif
 };
 
 static int kwnet_poll(struct napi_struct *napi, int budget)
@@ -89,9 +98,10 @@ static irqreturn_t kwnet_irq(int irq, void *dev_id)
 	return IRQ_HANDLED;
 }
 
-static netdev_tx_t kwnet_xmit(struct sk_buff *skb, struct net_device *dev)
+/* Hand @skb to the host and consume it (on CPU 0, bottom halves off). */
+static void kwnet_send(struct kwnet *priv, struct sk_buff *skb)
 {
-	struct kwnet *priv = netdev_priv(dev);
+	struct net_device *dev = priv->dev;
 	const void *data = skb->data;
 
 	if (skb->len > KWNET_MAX_FRAME) {
@@ -107,6 +117,34 @@ static netdev_tx_t kwnet_xmit(struct sk_buff *skb, struct net_device *dev)
 	dev->stats.tx_bytes += skb->len;
 out:
 	dev_consume_skb_any(skb);
+}
+
+#ifdef CONFIG_SMP
+static void kwnet_tx_work(struct work_struct *work)
+{
+	struct kwnet *priv = container_of(work, struct kwnet, tx_work);
+	struct sk_buff *skb;
+
+	local_bh_disable();	/* as in xmit: the bounce buffer is shared */
+	while ((skb = skb_dequeue(&priv->txq)))
+		kwnet_send(priv, skb);
+	local_bh_enable();
+}
+#endif
+
+static netdev_tx_t kwnet_xmit(struct sk_buff *skb, struct net_device *dev)
+{
+	struct kwnet *priv = netdev_priv(dev);
+
+#ifdef CONFIG_SMP
+	/* In order behind frames that wait for CPU 0. */
+	if (smp_processor_id() || !skb_queue_empty_lockless(&priv->txq)) {
+		skb_queue_tail(&priv->txq, skb);
+		queue_work_on(0, system_highpri_wq, &priv->tx_work);
+		return NETDEV_TX_OK;
+	}
+#endif
+	kwnet_send(priv, skb);
 	return NETDEV_TX_OK;
 }
 
@@ -118,8 +156,12 @@ static int kwnet_open(struct net_device *dev)
 	netif_carrier_on(dev);
 	netif_start_queue(dev);
 	/* Frames may have been queued while the device was down. */
+#ifdef CONFIG_SMP
+	kw_irq_raise(0, BIT(WASM_IRQ_NET));	/* CPU 0 looks */
+#else
 	if (wasm_driver_net_rx_len() > 0)
 		napi_schedule(&priv->napi);
+#endif
 	return 0;
 }
 
@@ -130,6 +172,10 @@ static int kwnet_stop(struct net_device *dev)
 	netif_stop_queue(dev);
 	netif_carrier_off(dev);
 	napi_disable(&priv->napi);
+#ifdef CONFIG_SMP
+	cancel_work_sync(&priv->tx_work);
+	skb_queue_purge(&priv->txq);
+#endif
 	return 0;
 }
 
@@ -174,6 +220,10 @@ static int __init kwnet_init(void)
 	else
 		eth_hw_addr_random(dev);
 	netif_napi_add(dev, &priv->napi, kwnet_poll);
+#ifdef CONFIG_SMP
+	skb_queue_head_init(&priv->txq);
+	INIT_WORK(&priv->tx_work, kwnet_tx_work);
+#endif
 	netif_carrier_off(dev);
 
 	err = request_irq(WASM_IRQ_NET, kwnet_irq, 0, "kwnet", dev);
diff --git a/drivers/tty/hvc/hvc_wasm.c b/drivers/tty/hvc/hvc_wasm.c
index 155b935ce8d..eddb08e94f7 100644
--- a/drivers/tty/hvc/hvc_wasm.c
+++ b/drivers/tty/hvc/hvc_wasm.c
@@ -1,6 +1,7 @@
 /* SPDX-License-Identifier: GPL-2.0-only */
 
 #include <linux/interrupt.h>
+#include <linux/kfifo.h>
 #include <linux/tty.h>
 #include <asm/irq.h>
 #include <asm/wasm.h>
@@ -10,6 +11,66 @@ static struct hvc_struct *hvc_wasm_hp;
 /* Last host window size (rows << 16 | cols) given to the tty; hp->lock. */
 static u32 hvc_wasm_size;
 
+#ifdef CONFIG_SMP
+/*
+ * SMP: the host's console is CPU 0's (its imports answer there), while
+ * khvcd and openers run on any CPU. CPU 0's console interrupt moves the
+ * input into this FIFO and records the window size; get_chars and
+ * notifier_add read those. Output (put_chars) works on every CPU: each
+ * CPU's host forwards it.
+ */
+static DEFINE_KFIFO(hvc_wasm_in, u8, 4096);
+/* The host window size as CPU 0 last read it. */
+static u32 hvc_wasm_host_size;
+/* The FIFO filled up: CPU 0 pulls more once there is room. */
+static bool hvc_wasm_in_full;
+
+/* CPU 0, interrupts off: take the host's input and window size. */
+static void hvc_wasm_pull(void)
+{
+	u8 buf[256];
+	ssize_t n;
+
+	WRITE_ONCE(hvc_wasm_host_size, wasm_driver_console_size());
+	while (kfifo_avail(&hvc_wasm_in)) {
+		n = wasm_console_read(buf, min_t(size_t, sizeof(buf),
+						 kfifo_avail(&hvc_wasm_in)));
+		if (n <= 0)
+			return;
+		kfifo_in(&hvc_wasm_in, buf, n);
+	}
+	WRITE_ONCE(hvc_wasm_in_full, true);
+}
+
+static u32 hvc_wasm_console_size(void)
+{
+	return READ_ONCE(hvc_wasm_host_size);
+}
+
+/* Called under hp->lock (one reader at a time). */
+static ssize_t hvc_wasm_read(u8 *buf, size_t count)
+{
+	ssize_t n = kfifo_out(&hvc_wasm_in, buf, count);
+
+	if (READ_ONCE(hvc_wasm_in_full) &&
+	    kfifo_avail(&hvc_wasm_in) >= kfifo_size(&hvc_wasm_in) / 2) {
+		WRITE_ONCE(hvc_wasm_in_full, false);
+		kw_irq_raise(0, BIT(WASM_IRQ_CONSOLE));	/* pull the rest */
+	}
+	return n;
+}
+#else
+static u32 hvc_wasm_console_size(void)
+{
+	return wasm_driver_console_size();
+}
+
+static ssize_t hvc_wasm_read(u8 *buf, size_t count)
+{
+	return wasm_console_read(buf, count);
+}
+#endif
+
 static struct winsize hvc_wasm_winsize(u32 size)
 {
 	return (struct winsize){ .ws_row = size >> 16, .ws_col = size & 0xffff };
@@ -32,13 +93,13 @@ static ssize_t hvc_wasm_get_chars(uint32_t vtermno, u8 *buf, size_t count)
 	u32 size;
 
 	if (hp) {
-		size = wasm_driver_console_size();
+		size = hvc_wasm_console_size();
 		if (size && size != hvc_wasm_size) {
 			hvc_wasm_size = size;
 			__hvc_resize(hp, hvc_wasm_winsize(size));
 		}
 	}
-	return wasm_console_read(buf, count);
+	return hvc_wasm_read(buf, count);
 }
 
 /*
@@ -48,7 +109,7 @@ static ssize_t hvc_wasm_get_chars(uint32_t vtermno, u8 *buf, size_t count)
  */
 static int hvc_wasm_notifier_add(struct hvc_struct *hp, int data)
 {
-	u32 size = wasm_driver_console_size();
+	u32 size = hvc_wasm_console_size();
 	struct winsize ws = hvc_wasm_winsize(size);
 	struct tty_struct *tty;
 	unsigned long flags;
@@ -76,6 +137,9 @@ static const struct hv_ops hvc_wasm_ops = {
 /* The host raises WASM_IRQ_CONSOLE on input or a resize: poll right away. */
 static irqreturn_t hvc_wasm_input_irq(int irq, void *dev_id)
 {
+#ifdef CONFIG_SMP
+	hvc_wasm_pull();
+#endif
 	hvc_kick();
 	return IRQ_HANDLED;
 }
@@ -88,6 +152,10 @@ static int __init hvc_wasm_init(void)
 	if (IS_ERR(hp))
 		return PTR_ERR(hp);
 	hvc_wasm_hp = hp;
+#ifdef CONFIG_SMP
+	/* In kernel_init, which runs on CPU 0. */
+	WRITE_ONCE(hvc_wasm_host_size, wasm_driver_console_size());
+#endif
 #ifdef WASM_IRQ_CONSOLE
 	if (request_irq(WASM_IRQ_CONSOLE, hvc_wasm_input_irq, 0, "hvc_wasm",
 			NULL))
