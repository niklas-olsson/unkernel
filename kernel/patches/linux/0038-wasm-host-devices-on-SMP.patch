@@ -317,6 +317,11 @@ static int __init kwsnd_init(void)
 		pr_info("kwsnd: no host audio\n");
 		return 0;
 	}
+	/* SMP: not yet; its host imports answer on CPU 0 alone, from any context. */
+	if (IS_ENABLED(CONFIG_SMP)) {
+		pr_warn("kwsnd: sound is not supported on SMP kernels yet\n");
+		return 0;
+	}
 	err = snd_card_new(NULL, -1, "kwsnd", THIS_MODULE, 0, &card);
 	if (err)
 		return err;
