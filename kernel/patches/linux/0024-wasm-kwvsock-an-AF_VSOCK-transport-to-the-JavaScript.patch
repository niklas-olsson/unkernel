From fa5bcc8253ffe215d39d1bb0244ace647746ed63 Mon Sep 17 00:00:00 2001
From: Pooya Parsa <pooya@pi0.io>
Date: Sun, 15 Nov 2026 10:16:10 +0000
Subject: [PATCH] wasm: kwvsock, an AF_VSOCK transport to the JavaScript host

A vsock transport built on virtio_transport_common, the way
vsock_loopback uses it, with the packets crossing through host imports
instead of virtqueues. The guest is CID 3 and the host CID 2; the host
runs the other end of the virtio-vsock protocol (connections, credit
flow control, shutdown, reset) itself.

Four imports, none of which suspends: wasm_driver_vsock_init(cid,
rx_max) (< 0: no device; then no transport is registered and nothing is
allocated), wasm_driver_vsock_send(hdr, data, len), which copies a packet
to the host and may refuse it with -EAGAIN, and wasm_driver_vsock_rx_len()
and wasm_driver_vsock_recv(buf, max), which take the packets the host
queued. The host raises WASM_IRQ_VSOCK (6) when it queued packets and
when it takes packets again after refusing one.

A refused packet stays first in a queue, with everything sent after it,
and a work item retries after the IRQ, so nothing is dropped; data
packets are bounded by the host's credit anyway. Received packets are
copied into skbs and handed to virtio_transport_recv_pkt() from a work
item; when an skb cannot be allocated the packet stays with the host and
is retried 10 ms later. The host keeps each packet within rx_max (an
order-3 linear skb), and a nonlinear outgoing payload goes through a
64 KiB bounce buffer. No SEQPACKET, no datagrams.

RX work is queued on system_percpu_wq (Linux 7.3 deprecates system_wq).
---
 net/vmw_vsock/Kconfig   |  13 ++
 net/vmw_vsock/Makefile  |   1 +
 net/vmw_vsock/kwvsock.c | 293 ++++++++++++++++++++++++++++++++++++++++
 3 files changed, 307 insertions(+)
 create mode 100644 net/vmw_vsock/kwvsock.c

diff --git a/net/vmw_vsock/Kconfig b/net/vmw_vsock/Kconfig
index 8e803c4828c..3ffc8c8fe31 100644
--- a/net/vmw_vsock/Kconfig
+++ b/net/vmw_vsock/Kconfig
@@ -38,6 +38,19 @@ config VSOCKETS_LOOPBACK
 	  To compile this driver as a module, choose M here: the module
 	  will be called vsock_loopback. If unsure, say N.
 
+config KWVSOCK
+	tristate "unkernel host transport for Virtual Sockets"
+	depends on VSOCKETS && WASM
+	select VIRTIO_VSOCKETS_COMMON
+	help
+	  This module implements a transport for Virtual Sockets to the
+	  JavaScript host of a unkernel instance (guest CID 3, host CID 2),
+	  using vmw_vsock_virtio_transport_common. Without a host device
+	  no transport is registered.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called kwvsock. If unsure, say N.
+
 config VMWARE_VMCI_VSOCKETS
 	tristate "VMware VMCI transport for Virtual Sockets"
 	depends on VSOCKETS && VMWARE_VMCI
diff --git a/net/vmw_vsock/Makefile b/net/vmw_vsock/Makefile
index 5da74c4a9f1..e4b30762411 100644
--- a/net/vmw_vsock/Makefile
+++ b/net/vmw_vsock/Makefile
@@ -6,6 +6,7 @@ obj-$(CONFIG_VIRTIO_VSOCKETS) += vmw_vsock_virtio_transport.o
 obj-$(CONFIG_VIRTIO_VSOCKETS_COMMON) += vmw_vsock_virtio_transport_common.o
 obj-$(CONFIG_HYPERV_VSOCKETS) += hv_sock.o
 obj-$(CONFIG_VSOCKETS_LOOPBACK) += vsock_loopback.o
+obj-$(CONFIG_KWVSOCK) += kwvsock.o
 
 vsock-y += af_vsock.o af_vsock_tap.o vsock_addr.o
 vsock-$(CONFIG_BPF_SYSCALL) += vsock_bpf.o
diff --git a/net/vmw_vsock/kwvsock.c b/net/vmw_vsock/kwvsock.c
new file mode 100644
index 00000000000..fedbe869114
--- /dev/null
+++ b/net/vmw_vsock/kwvsock.c
@@ -0,0 +1,293 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * kwvsock: an AF_VSOCK transport to the JavaScript host (unkernel).
+ *
+ * Copyright (C) 2026 Pooya Parsa <pooya@pi0.io>
+ *
+ * The guest is CID KWVSOCK_GUEST_CID, the host VMADDR_CID_HOST (2). The
+ * packets are virtio-vsock's (struct virtio_vsock_hdr, little-endian, then
+ * the payload), and everything above the packets (connections, credit flow
+ * control, shutdown and reset) is virtio_transport_common, the way
+ * vsock_loopback uses it. No virtio device or virtqueue is involved: the
+ * packets cross through host imports, so the host runs the other end of the
+ * protocol itself (js/core/vsock.ts in unkernel).
+ *
+ * Present only when the host offers it: wasm_driver_vsock_init() < 0 means
+ * no device, and then no transport is registered and nothing is allocated
+ * (AF_VSOCK sockets can still be created, and connect() fails with ENODEV
+ * as without any transport).
+ *
+ * Guest to host: send_pkt hands a packet to wasm_driver_vsock_send(), which
+ * copies it during the call. The host may refuse one (-EAGAIN) when it
+ * cannot take more; the packet then stays first in a queue, with everything
+ * sent after it, and a work item retries once the host raises
+ * WASM_IRQ_VSOCK. Nothing is dropped. Data packets are bounded anyway by
+ * the credit the host grants.
+ *
+ * Host to guest: the host queues packets and raises WASM_IRQ_VSOCK; like the
+ * other host interrupts it is polled when user mode returns to the kernel
+ * and in the idle loop. The handler schedules a work item, which takes each
+ * packet with wasm_driver_vsock_rx_len() and wasm_driver_vsock_recv() into a
+ * fresh skb and hands it to virtio_transport_recv_pkt() in process context.
+ * A packet whose skb cannot be allocated stays with the host and is retried
+ * a little later. The host keeps each packet within the size given at init,
+ * so every skb is linear and below PAGE_ALLOC_COSTLY_ORDER.
+ *
+ * No import here suspends.
+ */
+
+#include <linux/init.h>
+#include <linux/interrupt.h>
+#include <linux/module.h>
+#include <linux/skbuff.h>
+#include <linux/slab.h>
+#include <linux/virtio_vsock.h>
+#include <linux/workqueue.h>
+#include <asm/irq.h>
+#include <asm/wasm.h>
+
+/* The guest's CID (3, QEMU's usual first guest CID). The host is 2. */
+#define KWVSOCK_GUEST_CID	3
+
+/* Largest packet (header and payload) the host may queue for the guest. */
+#define KWVSOCK_RX_MAX		SKB_WITH_OVERHEAD(PAGE_SIZE << PAGE_ALLOC_COSTLY_ORDER)
+
+/* Packets taken per run of the receive work item before it yields. */
+#define KWVSOCK_RX_BATCH	64
+
+/* Host imports, module "unkernel" (js/core/vsock.ts). None of them suspends. */
+/*
+ * Offer the device: the guest's CID and the largest packet (header and
+ * payload) the guest takes. < 0: the host has no vsock device.
+ */
+int wasm_driver_vsock_init(u32 guest_cid, u32 rx_max)
+	__unkernel_import(wasm_driver_vsock_init);
+/*
+ * One packet to the host: the 44-byte header at @hdr, @len payload bytes at
+ * @data. The host copies both during the call. 0: taken; -EAGAIN: not now,
+ * the host raises WASM_IRQ_VSOCK once it takes packets again.
+ */
+int wasm_driver_vsock_send(const void *hdr, const void *data, u32 len)
+	__unkernel_import(wasm_driver_vsock_send);
+/* Size (header and payload) of the next queued packet, 0 if none. */
+u32 wasm_driver_vsock_rx_len(void)
+	__unkernel_import(wasm_driver_vsock_rx_len);
+/*
+ * Copy the next packet into @buf (at most @max bytes) and dequeue it;
+ * returns its size. @buf NULL drops it.
+ */
+int wasm_driver_vsock_recv(void *buf, u32 max)
+	__unkernel_import(wasm_driver_vsock_recv);
+
+struct kwvsock {
+	struct sk_buff_head tx_queue;	/* packets the host has not taken yet */
+	struct work_struct tx_work;
+	struct delayed_work rx_work;
+	void *tx_bounce;		/* a nonlinear packet's payload, made linear */
+	unsigned long rx_dropped;	/* malformed packets from the host */
+};
+
+static struct kwvsock kwvsock;
+
+static u32 kwvsock_get_local_cid(void)
+{
+	return KWVSOCK_GUEST_CID;
+}
+
+/* Hand @skb to the host; true if it took it (the skb is then consumed). */
+static bool kwvsock_xmit(struct sk_buff *skb)
+{
+	const void *data = skb->data;
+	int ret;
+
+	if (skb->len && skb_is_nonlinear(skb)) {
+		skb_copy_bits(skb, 0, kwvsock.tx_bounce, skb->len);
+		data = kwvsock.tx_bounce;
+	}
+	ret = wasm_driver_vsock_send(virtio_vsock_hdr(skb), skb->len ? data : NULL, skb->len);
+	if (ret == -EAGAIN)
+		return false;
+	/* Any other result: the host has it, or never will (an error). */
+	virtio_transport_deliver_tap_pkt(skb);
+	virtio_transport_consume_skb_sent(skb, true);
+	return true;
+}
+
+static void kwvsock_tx_work(struct work_struct *work)
+{
+	struct sk_buff *skb;
+
+	while ((skb = virtio_vsock_skb_dequeue(&kwvsock.tx_queue))) {
+		if (!kwvsock_xmit(skb)) {
+			virtio_vsock_skb_queue_head(&kwvsock.tx_queue, skb);
+			break;	/* until the host raises WASM_IRQ_VSOCK */
+		}
+	}
+}
+
+static int kwvsock_send_pkt(struct sk_buff *skb, struct net *net)
+{
+	int len = skb->len;
+
+	/*
+	 * Straight to the host while nothing waits before it (the kernel is
+	 * UP without preemption, so the check and the send cannot race the
+	 * work item); else in order behind the waiting packets.
+	 */
+	if (skb_queue_empty_lockless(&kwvsock.tx_queue) && kwvsock_xmit(skb))
+		return len;
+	virtio_vsock_skb_queue_tail(&kwvsock.tx_queue, skb);
+	return len;
+}
+
+static int kwvsock_cancel_pkt(struct vsock_sock *vsk)
+{
+	virtio_transport_purge_skbs(vsk, &kwvsock.tx_queue);
+	return 0;
+}
+
+static bool kwvsock_stream_allow(struct vsock_sock *vsk, u32 cid, u32 port)
+{
+	return vsock_net_mode_global(vsk);
+}
+
+static bool kwvsock_seqpacket_allow(struct vsock_sock *vsk, u32 remote_cid)
+{
+	return false;	/* the host does not do SEQPACKET (VIRTIO_VSOCK_F_SEQPACKET) */
+}
+
+static struct virtio_transport kwvsock_transport = {
+	.transport = {
+		.module                   = THIS_MODULE,
+
+		.get_local_cid            = kwvsock_get_local_cid,
+
+		.init                     = virtio_transport_do_socket_init,
+		.destruct                 = virtio_transport_destruct,
+		.release                  = virtio_transport_release,
+		.connect                  = virtio_transport_connect,
+		.shutdown                 = virtio_transport_shutdown,
+		.cancel_pkt               = kwvsock_cancel_pkt,
+
+		.dgram_bind               = virtio_transport_dgram_bind,
+		.dgram_dequeue            = virtio_transport_dgram_dequeue,
+		.dgram_enqueue            = virtio_transport_dgram_enqueue,
+		.dgram_allow              = virtio_transport_dgram_allow,
+
+		.stream_dequeue           = virtio_transport_stream_dequeue,
+		.stream_enqueue           = virtio_transport_stream_enqueue,
+		.stream_has_data          = virtio_transport_stream_has_data,
+		.stream_has_space         = virtio_transport_stream_has_space,
+		.stream_rcvhiwat          = virtio_transport_stream_rcvhiwat,
+		.stream_is_active         = virtio_transport_stream_is_active,
+		.stream_allow             = kwvsock_stream_allow,
+
+		.seqpacket_dequeue        = virtio_transport_seqpacket_dequeue,
+		.seqpacket_enqueue        = virtio_transport_seqpacket_enqueue,
+		.seqpacket_allow          = kwvsock_seqpacket_allow,
+		.seqpacket_has_data       = virtio_transport_seqpacket_has_data,
+
+		.notify_poll_in           = virtio_transport_notify_poll_in,
+		.notify_poll_out          = virtio_transport_notify_poll_out,
+		.notify_recv_init         = virtio_transport_notify_recv_init,
+		.notify_recv_pre_block    = virtio_transport_notify_recv_pre_block,
+		.notify_recv_pre_dequeue  = virtio_transport_notify_recv_pre_dequeue,
+		.notify_recv_post_dequeue = virtio_transport_notify_recv_post_dequeue,
+		.notify_send_init         = virtio_transport_notify_send_init,
+		.notify_send_pre_block    = virtio_transport_notify_send_pre_block,
+		.notify_send_pre_enqueue  = virtio_transport_notify_send_pre_enqueue,
+		.notify_send_post_enqueue = virtio_transport_notify_send_post_enqueue,
+		.notify_buffer_size       = virtio_transport_notify_buffer_size,
+		.notify_set_rcvlowat      = virtio_transport_notify_set_rcvlowat,
+
+		.unsent_bytes             = virtio_transport_unsent_bytes,
+
+		.read_skb                 = virtio_transport_read_skb,
+	},
+
+	.send_pkt = kwvsock_send_pkt,
+};
+
+static void kwvsock_rx_work(struct work_struct *work)
+{
+	int n;
+
+	for (n = 0; n < KWVSOCK_RX_BATCH; n++) {
+		u32 len = wasm_driver_vsock_rx_len(), payload;
+		struct virtio_vsock_hdr *hdr;
+		struct sk_buff *skb;
+
+		if (!len)
+			return;
+		if (len < sizeof(*hdr) || len > KWVSOCK_RX_MAX) {
+			wasm_driver_vsock_recv(NULL, 0);
+			kwvsock.rx_dropped++;
+			continue;
+		}
+		skb = virtio_vsock_alloc_linear_skb(len, GFP_KERNEL);
+		if (!skb) {
+			/* The host keeps the packet: try again a little later. */
+			schedule_delayed_work(&kwvsock.rx_work, msecs_to_jiffies(10));
+			return;
+		}
+		/* The header lands in the headroom, the payload at skb->data. */
+		wasm_driver_vsock_recv(skb->head, len);
+		hdr = virtio_vsock_hdr(skb);
+		payload = le32_to_cpu(hdr->len);
+		if (payload != len - sizeof(*hdr)) {
+			kfree_skb(skb);
+			kwvsock.rx_dropped++;
+			continue;
+		}
+		if (payload)
+			virtio_vsock_skb_put(skb, payload);
+		virtio_transport_deliver_tap_pkt(skb);
+		/* NULL: global mode, as virtio-vsock (no local-mode namespaces). */
+		virtio_transport_recv_pkt(&kwvsock_transport, skb, NULL);
+	}
+	/* More may be queued: let other work run first. */
+	mod_delayed_work(system_percpu_wq, &kwvsock.rx_work, 0);
+}
+
+static irqreturn_t kwvsock_irq(int irq, void *dev_id)
+{
+	mod_delayed_work(system_percpu_wq, &kwvsock.rx_work, 0);
+	if (!skb_queue_empty_lockless(&kwvsock.tx_queue))
+		schedule_work(&kwvsock.tx_work);
+	return IRQ_HANDLED;
+}
+
+static int __init kwvsock_init(void)
+{
+	int err;
+
+	if (wasm_driver_vsock_init(KWVSOCK_GUEST_CID, KWVSOCK_RX_MAX) < 0) {
+		pr_info("kwvsock: no host vsock\n");
+		return 0;
+	}
+
+	skb_queue_head_init(&kwvsock.tx_queue);
+	INIT_WORK(&kwvsock.tx_work, kwvsock_tx_work);
+	INIT_DELAYED_WORK(&kwvsock.rx_work, kwvsock_rx_work);
+	kwvsock.tx_bounce = kvmalloc(VIRTIO_VSOCK_MAX_PKT_BUF_SIZE, GFP_KERNEL);
+	if (!kwvsock.tx_bounce)
+		return -ENOMEM;
+
+	err = request_irq(WASM_IRQ_VSOCK, kwvsock_irq, 0, "kwvsock", &kwvsock);
+	if (err)
+		goto err_free;
+	err = vsock_core_register(&kwvsock_transport.transport, VSOCK_TRANSPORT_F_G2H);
+	if (err)
+		goto err_irq;
+	pr_info("kwvsock: host vsock, guest CID %u\n", KWVSOCK_GUEST_CID);
+	/* Packets may have been queued before the handler existed. */
+	schedule_delayed_work(&kwvsock.rx_work, 0);
+	return 0;
+
+err_irq:
+	free_irq(WASM_IRQ_VSOCK, &kwvsock);
+err_free:
+	kvfree(kwvsock.tx_bounce);
+	return err;
+}
+device_initcall(kwvsock_init);
-- 
