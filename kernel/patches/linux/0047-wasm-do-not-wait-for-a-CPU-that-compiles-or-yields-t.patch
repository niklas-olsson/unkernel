From 2c81bcbefbb1e03aab3c7bd59b169ffa2e959956 Mon Sep 17 00:00:00 2001
From: kernel-wasm <kernel-wasm@localhost>
Date: Tue, 17 Nov 2026 14:38:17 +0000
Subject: [PATCH] wasm: do not wait for a CPU that compiles or yields to its
 host (SMP)

A CPU takes interrupts only between kwemu's blocks and in the kernel. Two
things keep it away from both for long stretches of host time: a JIT
compile (kwemu gathering and emitting a module, the host compiling and
instantiating it and V8 compiling it at its first call: 0.1-0.4 ms, up to
a few ms) and the yield to the host every 20 ms of user code, where the
engine's finalizers and collections of freed JIT modules ran for up to
19 ms. A TLB shootdown to such a CPU waited all that time.

kwemu (ABI 8) now marks a compile: jit_busy in struct kw_cpu is 1 while
it neither runs user code nor touches user memory or page tables, and
it flushes everything before it runs user code again if another CPU set
flush_all meanwhile. kw_flush_later() skips such a CPU the way it skips
one in lazy TLB mode (flush_all = 1, smp_mb(), jit_busy still set with
acquire: skip; kwemu clears jit_busy, then takes flush_all). The yield
(kw_yield_to_host()) marks the CPU lazy until it is back, and flushes
everything then if a flusher marked it; on SMP it now comes after the
pending interrupts are taken, so an IPI that ended the user code is not
held up by it. flush_tlb_all(), and with it riscv_flush_icache, skips
lazy, yielding and compiling CPUs as well instead of waiting for every
online one.

kwipi churn on 2 CPUs (CPU 1 compiling all the time, CPU 0 timing the
mprotect() calls that shoot it down): p99.9 130 to 13 us, max 20 to
3.9 ms, calls over 1 ms 194 to 3. The UP kernel's C code is unchanged.
---
 arch/wasm/include/asm/kw_emu.h   |  29 ++++++++-
 arch/wasm/include/asm/tlbflush.h |   7 +++
 arch/wasm/kernel/traps.c         |  16 ++++-
 arch/wasm/mm/tlb.c               | 105 ++++++++++++++++++++++++-------
 4 files changed, 130 insertions(+), 27 deletions(-)

diff --git a/arch/wasm/include/asm/kw_emu.h b/arch/wasm/include/asm/kw_emu.h
index fe4eaee612d..3308c54e1fe 100644
--- a/arch/wasm/include/asm/kw_emu.h
+++ b/arch/wasm/include/asm/kw_emu.h
@@ -44,6 +44,21 @@
  * Guest stores are tracked only by the struct kw_cpu that runs them: code
  * another CPU rewrites is seen after a flush on this one (riscv's
  * flush_icache syscall, FENCE.I alone is local), as on hardware.
+ *
+ * Flushes during a JIT compile (ABI 8): a compile takes a few hundred
+ * microseconds, and the CPU answers no interrupt meanwhile. Around each
+ * (choosing the blocks, emitting the module, kw_host_jit_compile()) kwemu
+ * sets jit_busy (below) to 1 and back to 0; in between it runs no guest
+ * instruction and touches no guest memory and no page table. Another CPU that needs this one's TLB flushed may then
+ * skip waiting for it: it sets flush_all to 1, issues a full barrier and
+ * reads jit_busy with acquire semantics; only if it reads 1 may it go on
+ * without this CPU's answer. When the call returns, kwemu stores 0 to
+ * jit_busy, issues a full barrier, takes flush_all (atomic exchange with
+ * 0) and, if it was set, does what kw_flush_tlb_all() does before it runs
+ * any guest code. So either the flusher sees the window closed (and waits
+ * as usual), or kwemu sees the request. Guest stores before the window are
+ * ordered before its jit_busy = 1 (a release store). Only kwemu clears
+ * flush_all; a kwemu built without atomics (one hart) never sees it set.
  */
 #ifndef KW_EMU_H
 #define KW_EMU_H
@@ -58,7 +73,7 @@
 extern "C" {
 #endif
 
-#define KW_ABI_VERSION 7
+#define KW_ABI_VERSION 8
 
 struct kw_regs {
 	uint64_t x[32];   /* x[0] is ignored and reads as zero */
@@ -112,6 +127,9 @@ struct kw_cpu {
 	uint64_t budget;               /* instructions kw_run may execute */
 	uint64_t icount;               /* total instructions executed (stats) */
 	struct kw_event ev;            /* details of the last event */
+	/* ABI 8, see "Flushes during a JIT compile" above */
+	uint32_t jit_busy;             /* written by kwemu only */
+	uint32_t flush_all;            /* set by other CPUs, cleared by kwemu */
 };
 
 /* Zero and initialise the whole KW_CPU_SIZE block. */
@@ -209,11 +227,16 @@ void kw_host_reset(struct kw_cpu *cpu);
  *            generated code imports a 32-bit memory);
  *     bit 2: eager, compile blocks on first entry (tests).
  *     Called from kw_cpu_init and kw_host_reset.
- *   int32_t kw_host_jit_compile(const uint8_t *module, size_t len, uint32_t slot);
+ *   int32_t kw_host_jit_compile(const uint8_t *module, size_t len, uint32_t slot,
+ *                               uint32_t flags);
  *     Synchronously compile the module (it imports "env" "memory", i.e.
  *     this memory, and exports function "f", type (i64 i64 i64 i64) -> i64)
  *     and install "f" into table slot `slot`. 0 = installed; < 0 = failed,
- *     slot untouched.
+ *     slot untouched. flags bit 0 (ABI 8; older kwemu passes no flags): f
+ *     called with a second argument of 0 returns 0 at once and touches
+ *     nothing, so a host whose engine compiles a function only at its first
+ *     call can have it compiled here, inside the jit_busy window, by
+ *     calling f(0, 0, 0, 0).
  *   void kw_host_jit_free(uint32_t slot);
  *     Restore the function the slot held before its first compile and drop
  *     the module.
diff --git a/arch/wasm/include/asm/tlbflush.h b/arch/wasm/include/asm/tlbflush.h
index c6369fd7ff4..6573bbd7f01 100644
--- a/arch/wasm/include/asm/tlbflush.h
+++ b/arch/wasm/include/asm/tlbflush.h
@@ -18,6 +18,13 @@ void flush_tlb_range(struct vm_area_struct *vma, unsigned long start,
 /* riscv_flush_icache(): drop decoded code (every CPU's on SMP). */
 void kw_flush_icache_all(void);
 
+/* wasm_yield() from user mode; SMP: flushes do not wait for it (tlb.c). */
+#ifdef CONFIG_SMP
+void kw_yield_to_host(void);
+#else
+#define kw_yield_to_host() wasm_yield()
+#endif
+
 static inline void flush_tlb_kernel_range(unsigned long start,
 					  unsigned long end)
 {
diff --git a/arch/wasm/kernel/traps.c b/arch/wasm/kernel/traps.c
index b439f07ef39..017d8284512 100644
--- a/arch/wasm/kernel/traps.c
+++ b/arch/wasm/kernel/traps.c
@@ -19,6 +19,7 @@
 #include <asm/kwcpu.h>
 #include <asm/park.h>
 #include <asm/syscall.h>
+#include <asm/tlbflush.h>
 #include <asm/wasm.h>
 
 /*
@@ -99,21 +100,30 @@ static void do_user_fault(struct pt_regs *regs, unsigned long addr,
 static void do_user_interrupt(struct pt_regs *regs)
 {
 	u64 now = wasm_cpu_clock_get_monotonic();
+	bool yield = now - last_yield_ns >= KW_YIELD_NS;
 
 	/*
 	 * SMP: every CPU yields to its own host. CPU 0's serves the devices;
 	 * the others' event loops run the engine's housekeeping, without
 	 * which modules the JIT freed are never collected (finalizers and
-	 * the collector's last pass run as tasks there).
+	 * the collector's last pass run as tasks there). That can take
+	 * milliseconds, so on SMP it comes after the pending interrupts are
+	 * taken (an IPI's sender may be waiting), and TLB flushes sent during
+	 * it do not wait for it (tlb.c).
 	 */
-	if (now - last_yield_ns >= KW_YIELD_NS) {
-		wasm_yield();
+	if (yield && !IS_ENABLED(CONFIG_SMP)) {
+		kw_yield_to_host();
 		last_yield_ns = wasm_cpu_clock_get_monotonic();
 	}
 
 	irqentry_enter_from_user_mode(regs);
 	wasm_poll_irqs(regs);
 	irqentry_exit_to_user_mode(regs);
+
+	if (yield && IS_ENABLED(CONFIG_SMP)) {
+		kw_yield_to_host();
+		last_yield_ns = wasm_cpu_clock_get_monotonic();
+	}
 }
 
 void __noreturn user_mode_loop(struct pt_regs *regs)
diff --git a/arch/wasm/mm/tlb.c b/arch/wasm/mm/tlb.c
index f0d1a12c122..671411d43d2 100644
--- a/arch/wasm/mm/tlb.c
+++ b/arch/wasm/mm/tlb.c
@@ -12,7 +12,8 @@
  * uaccess walk (fault.c) has no poll point between its walk and the end of
  * its copy, so a CPU that is copying cannot answer before it is done.
  * A PTE that only gains access needs no other CPU's flush
- * (update_mmu_cache_range()).
+ * (update_mmu_cache_range()). Nor is a CPU waited for while its kwemu
+ * compiles (kw_flush_later()).
  */
 
 #include <linux/init.h>
@@ -98,6 +99,27 @@ void enter_lazy_tlb(struct mm_struct *mm, struct task_struct *tsk)
 	if (mm != &init_mm)
 		this_cpu_write(kw_tlb_lazy, 1);
 }
+
+/*
+ * The yield to the host every 20 ms of user code (traps.c). The host's
+ * event loop may take milliseconds there (on a secondary: the engine's
+ * finalizers and collections of freed JIT modules; on CPU 0 the devices
+ * too), and the CPU takes no interrupt meanwhile. It runs no user code and
+ * does no uaccess walk in it, so a flush need not wait for it: it counts
+ * as lazy (above) until it is back, and then flushes everything if a
+ * flusher marked it, before it runs user code again.
+ */
+void kw_yield_to_host(void)
+{
+	smp_store_release(this_cpu_ptr(&kw_tlb_lazy), 1);
+	wasm_yield();
+	this_cpu_write(kw_tlb_lazy, 0);
+	smp_mb();
+	if (this_cpu_read(kw_tlb_stale)) {
+		this_cpu_write(kw_tlb_stale, 0);
+		kw_flush_tlb_all(wasm_kw_cpu);
+	}
+}
 #endif
 
 void switch_mm(struct mm_struct *prev, struct mm_struct *next,
@@ -157,37 +179,78 @@ static void kw_flush_local(void *info)
 		kw_flush_tlb_all(wasm_kw_cpu);
 }
 
-/* Flush here and on every other CPU that has @mm loaded, and wait for them. */
+/*
+ * Whether @cpu may flush later instead of answering a flush now: it is in
+ * lazy TLB mode (above; kw_yield_to_host() too), or its kwemu is inside a
+ * JIT compile, a few hundred microseconds of host time in which the CPU
+ * takes no interrupt (kw_emu.h, "Flushes during a JIT compile"). In one, kwemu runs no user
+ * code and reads no user memory or page table, and at its end, if it sees
+ * flush_all, it flushes everything (as kw_flush_tlb_all()) before it runs
+ * user code again. The same pairing as for lazy TLB:
+ *   flusher:  flush_all = 1; smp_mb();      jit_busy (acquire)?  skip : IPI
+ *   kwemu:    jit_busy = 0;  full barrier;  flush_all (xchg 0)?  flush
+ * The acquires pair with kwemu's release store of jit_busy = 1 (and with
+ * kw_yield_to_host()'s of kw_tlb_lazy), so the user stores that CPU made
+ * before are visible here before the caller frees or reuses their pages
+ * (as csd_unlock() makes them when the CPU answers). A flush of a range becomes a flush of everything there.
+ */
+static bool kw_flush_later(int cpu)
+{
+	struct kw_cpu *k = kw_cpus[cpu];
+
+	if (READ_ONCE(per_cpu(kw_tlb_lazy, cpu))) {
+		WRITE_ONCE(per_cpu(kw_tlb_stale, cpu), 1);
+		smp_mb();
+		if (smp_load_acquire(&per_cpu(kw_tlb_lazy, cpu)))
+			return true;
+	}
+	if (READ_ONCE(k->jit_busy)) {
+		WRITE_ONCE(k->flush_all, 1);
+		smp_mb();
+		if (smp_load_acquire(&k->jit_busy))
+			return true;
+	}
+	return false;
+}
+
+/*
+ * Flush here and on every other CPU in @mask (every online CPU if NULL),
+ * waiting for those that cannot flush later.
+ */
+static void kw_flush_cpus(const struct cpumask *mask, struct kw_flush *f)
+{
+	int self = get_cpu(), cpu;
+	cpumask_t wait;
+
+	kw_flush_local(f);
+	cpumask_clear(&wait);
+	for_each_cpu(cpu, mask ?: cpu_online_mask) {
+		if (cpu != self && !kw_flush_later(cpu))
+			__cpumask_set_cpu(cpu, &wait);
+	}
+	if (!cpumask_empty(&wait))
+		smp_call_function_many(&wait, kw_flush_local, f, true);
+	put_cpu();
+}
+
+/* Flush here and on every other CPU that has @mm loaded. */
 static void kw_flush_mm(struct mm_struct *mm, unsigned long start,
 			unsigned long end)
 {
 	struct kw_flush f = { .mm = mm, .start = start, .end = end };
-	int self = get_cpu(), cpu;
-	cpumask_t wait;
 
-	kw_flush_local(&f);
-	cpumask_clear(&wait);
-	for_each_cpu(cpu, mm_cpumask(mm)) {
-		if (cpu == self)
-			continue;
-		if (READ_ONCE(per_cpu(kw_tlb_lazy, cpu))) {
-			WRITE_ONCE(per_cpu(kw_tlb_stale, cpu), 1);
-			smp_mb();
-			if (READ_ONCE(per_cpu(kw_tlb_lazy, cpu)))
-				continue;
-		}
-		__cpumask_set_cpu(cpu, &wait);
-	}
-	if (!cpumask_empty(&wait))
-		smp_call_function_many(&wait, kw_flush_local, &f, true);
-	put_cpu();
+	kw_flush_cpus(mm_cpumask(mm), &f);
 }
 
+/*
+ * Every CPU. One in lazy TLB mode need not answer either: it flushes when
+ * it takes its mm again, and another mm drops everything (kw_set_pgd()).
+ */
 void flush_tlb_all(void)
 {
 	struct kw_flush f = { };
 
-	on_each_cpu(kw_flush_local, &f, 1);
+	kw_flush_cpus(NULL, &f);
 }
 
 void flush_tlb_mm(struct mm_struct *mm)
-- 
2.56.0

