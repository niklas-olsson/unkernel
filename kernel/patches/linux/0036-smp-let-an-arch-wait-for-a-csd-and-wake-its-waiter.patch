From f43d410db3a2730d9125dca3c3d9019ffff5228d Mon Sep 17 00:00:00 2001
From: kernel-wasm <kernel-wasm@localhost>
Date: Mon, 16 Nov 2026 23:07:54 +0000
Subject: [PATCH] smp: let an arch wait for a csd and wake its waiter

A cross-CPU call's sender spins in csd_lock_wait() until the target
clears CSD_FLAG_LOCK. On an arch whose CPUs are threads of a host that
may deschedule them at any time (Wasm), a sender that spins while the
target's thread is not running burns host time and makes itself look
busy; it wants to spin only for a while and then block until the
unlock, which then has to wake it.

Add two optional hooks: arch_csd_lock_wait(flags), called by
csd_lock_wait() while the csd is locked (the generic wait that follows
then returns at once and provides the acquire), and
arch_csd_unlocked(flags), called by csd_unlock() after its release
store; it must not dereference flags, since the csd may be reused or
gone by then. Without them nothing changes. CSD_LOCK_WAIT_DEBUG's wait
is left as it is.
---
 kernel/smp.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/kernel/smp.c b/kernel/smp.c
index b696bcc60c0..40093f2dde2 100644
--- a/kernel/smp.c
+++ b/kernel/smp.c
@@ -373,6 +373,11 @@ static void csd_lock_record(call_single_data_t *csd)
 
 static __always_inline void csd_lock_wait(call_single_data_t *csd)
 {
+#ifdef arch_csd_lock_wait
+	/* The arch's wait: it may block for a while instead of spinning. */
+	if (READ_ONCE(csd->node.u_flags) & CSD_FLAG_LOCK)
+		arch_csd_lock_wait(&csd->node.u_flags);
+#endif
 	smp_cond_load_acquire(&csd->node.u_flags, !(VAL & CSD_FLAG_LOCK));
 }
 #endif
@@ -413,6 +418,10 @@ static __always_inline void csd_unlock(call_single_data_t *csd)
 	 * ensure we're all done before releasing data:
 	 */
 	smp_store_release(&csd->node.u_flags, 0);
+#ifdef arch_csd_unlocked
+	/* Wake a waiter that blocks in arch_csd_lock_wait(). */
+	arch_csd_unlocked(&csd->node.u_flags);
+#endif
 }
 
 static DEFINE_PER_CPU_SHARED_ALIGNED(call_single_data_t, csd_data);
-- 
