From 0b3add7f4bf282a9730a0a44ebb4a155e38e44d0 Mon Sep 17 00:00:00 2001
From: kernel-wasm <kernel-wasm@localhost>
Date: Tue, 17 Nov 2026 09:05:49 +0000
Subject: [PATCH] wasm: take a free spinlock out of turn (kw_spin_unfair=, SMP)

Ticket locks are FIFO, so a waiter whose host thread is descheduled
holds up every waiter behind it even once the lock is free (lock-waiter
preemption); blocking instead of spinning does not help there. With 8
CPUs beside 24 busy host threads, 8 threads hammering one kernel
spinlock took 9.95 s with ticket locks and 0.08 s without.

With kw_spin_unfair=1, the default, a CPU takes no ticket: it takes the
lock as arch_spin_trylock() does, only while no ticket is outstanding,
and otherwise waits for that in kw_steal_wait(), which spins, blocks
and is kicked as a ticket waiter. Waiters are then served in no
particular order, as on x86 guests without PV spinlocks
(virt_spin_lock()). Both kinds share the lock word, the unlock and the
kick, so the parameter (a boot parameter, writable in
/sys/module/kernel/parameters/) may change at any time: a ticket holder
is served in turn, a CPU without a ticket never overtakes one, and one
still waiting when the parameter turns 0 takes a ticket (fair waiters
arriving all the time may keep the lock from ever being free without
one). arch_spin_is_contended() sees only tickets; its users here,
spin_needbreak() and rwlock_needbreak() without preemption, return 0
anyway. qrwlock's wait_lock becomes unfair too; a waiting writer still
holds it, so readers cannot starve the writer.

On realistic guest workloads (compiles, configure, file systems, node,
Python, apk; 2-8 CPUs, idle to 2x oversubscribed host) both measure the
same. With several CPUs on one hot spinlock the ticket lock convoys
50-70x at 8 CPUs once the host has no more free threads than the guest
has CPUs, while taking locks out of turn costs about 1.5x there on an
idle host. With the parameter 0 the cost is one read of a
__read_mostly flag per lock.
---
 arch/wasm/include/asm/spinlock.h | 44 ++++++++++++++++++++++++--------
 arch/wasm/kernel/wait.c          | 41 +++++++++++++++++++++++++++--
 2 files changed, 72 insertions(+), 13 deletions(-)

diff --git a/arch/wasm/include/asm/spinlock.h b/arch/wasm/include/asm/spinlock.h
index 1ead9e82279..13974347942 100644
--- a/arch/wasm/include/asm/spinlock.h
+++ b/arch/wasm/include/asm/spinlock.h
@@ -11,24 +11,28 @@
  * 16-bit add on the owner half (a full barrier, cheaper than the fence plus
  * store of smp_store_release()), which also orders it before the read of
  * kw_lock_sleepers.
+ *
+ * A ticket waiter whose thread the host has descheduled holds up every
+ * waiter behind it, even once the lock is free. So by default
+ * (kw_spin_unfair=1, wait.c) a CPU takes no ticket: it takes the lock as
+ * arch_spin_trylock() does, only while no ticket is outstanding, and
+ * otherwise waits for that in kw_steal_wait() (spinning, blocking and
+ * kicked as a ticket waiter). Waiters are then served in no particular
+ * order, as on x86 guests without PV spinlocks (virt_spin_lock()). Both
+ * kinds share the word, the unlock and the kick, so the parameter may
+ * change at any time: a ticket holder is served in turn, a CPU without
+ * one never overtakes a ticket, and one still waiting when the parameter
+ * turns 0 takes a ticket. arch_spin_is_contended() sees only tickets.
  */
 #include <linux/atomic.h>
 #include <asm-generic/spinlock_types.h>
 
 void kw_ticket_wait(arch_spinlock_t *lock, u16 ticket);
 void kw_ticket_kick(arch_spinlock_t *lock);
-/* CPUs blocked in kw_ticket_wait() (the unlock kicks them). */
+void kw_steal_wait(arch_spinlock_t *lock);
+/* CPUs blocked in a lock wait (wait.c; the unlock kicks them). */
 extern int kw_lock_sleepers;
-
-static __always_inline void arch_spin_lock(arch_spinlock_t *lock)
-{
-	u32 val = atomic_fetch_add(1 << 16, &lock->val);
-	u16 ticket = val >> 16;
-
-	if (ticket == (u16)val)
-		return;
-	kw_ticket_wait(lock, ticket);
-}
+extern bool kw_spin_unfair;
 
 static __always_inline bool arch_spin_trylock(arch_spinlock_t *lock)
 {
@@ -40,6 +44,24 @@ static __always_inline bool arch_spin_trylock(arch_spinlock_t *lock)
 	return atomic_try_cmpxchg(&lock->val, &old, old + (1 << 16)); /* SC, for RCsc */
 }
 
+static __always_inline void kw_ticket_lock(arch_spinlock_t *lock)
+{
+	u32 val = atomic_fetch_add(1 << 16, &lock->val);
+	u16 ticket = val >> 16;
+
+	if (ticket == (u16)val)
+		return;
+	kw_ticket_wait(lock, ticket);
+}
+
+static __always_inline void arch_spin_lock(arch_spinlock_t *lock)
+{
+	if (!READ_ONCE(kw_spin_unfair))
+		kw_ticket_lock(lock);
+	else if (unlikely(!arch_spin_trylock(lock)))
+		kw_steal_wait(lock);
+}
+
 static __always_inline void arch_spin_unlock(arch_spinlock_t *lock)
 {
 	/* Little endian: the owner is the low half. */
diff --git a/arch/wasm/kernel/wait.c b/arch/wasm/kernel/wait.c
index 4a69dca3fab..7320972287a 100644
--- a/arch/wasm/kernel/wait.c
+++ b/arch/wasm/kernel/wait.c
@@ -20,10 +20,14 @@
  * notifies the word), so it still answers shootdowns while it waits. A
  * spinlock unlock and csd_unlock() kick blocked waiters (KW_IPI_KICK); the
  * other spins (smp_cond_load_*(), asm/barrier.h) rely on the timeout.
- * kw_spin_us=0 spins as before. Both are writable in
- * /sys/module/kernel/parameters/. Every 256 spins the waiter also takes
+ * kw_spin_us=0 spins as before. Every 256 spins the waiter also takes
  * its timer if it expired (kw_spin_timer()).
  *
+ * kw_spin_unfair= (default 1) lets a CPU take a free spinlock out of turn
+ * while no ticket is outstanding (asm/spinlock.h); 0 makes spinlocks fair
+ * ticket locks. All three parameters are boot parameters and writable in
+ * /sys/module/kernel/parameters/ at any time.
+ *
  * Nothing here suspends under JSPI: memory.atomic.wait32 blocks the thread
  * (a CPU's thread may block: SMP runs every CPU in a worker), and the
  * clock is a plain import.
@@ -38,6 +42,9 @@
 #include <asm/irq.h>
 #include <asm/wasm.h>
 
+bool kw_spin_unfair __read_mostly = true;
+EXPORT_SYMBOL(kw_spin_unfair);
+core_param(kw_spin_unfair, kw_spin_unfair, bool, 0644);
 static unsigned int kw_spin_us = 20;
 static unsigned int kw_spin_sleep_us = 100;
 core_param(kw_spin_us, kw_spin_us, uint, 0644);
@@ -197,6 +204,36 @@ void kw_ticket_kick(arch_spinlock_t *lock)
 }
 EXPORT_SYMBOL(kw_ticket_kick);
 
+static bool kw_steal_busy(void *key, unsigned long arg)
+{
+	arch_spinlock_t *lock = key;
+	u32 val = __atomic_load_n(&lock->val.counter, __ATOMIC_SEQ_CST);
+
+	return (val >> 16) != (val & 0xffff);
+}
+
+/*
+ * arch_spin_lock() with kw_spin_unfair=1: until the lock is free with no
+ * ticket outstanding, then take it. Only an unlock makes it so, and every
+ * unlock with sleepers kicks all of them, so the ticket protocol holds.
+ * Once the parameter is 0, take a ticket: with fair waiters arriving all
+ * the time the lock may never be free without one.
+ */
+void kw_steal_wait(arch_spinlock_t *lock)
+{
+	struct kw_spin s = { 0, 0 };
+
+	do {
+		if (kw_spun_out(&s))
+			kw_block_on(&kw_lock_waiting, &kw_lock_sleepers, lock,
+				    kw_steal_busy, 0);
+		if (arch_spin_trylock(lock))
+			return;
+	} while (READ_ONCE(kw_spin_unfair));
+	kw_ticket_lock(lock);
+}
+EXPORT_SYMBOL(kw_steal_wait);
+
 static bool kw_csd_busy(void *key, unsigned long arg)
 {
 	return __atomic_load_n((unsigned int *)key, __ATOMIC_SEQ_CST) & CSD_FLAG_LOCK;
-- 
