From f72f7b8d8130ec9186f4de5244053d704bb59ef2 Mon Sep 17 00:00:00 2001
From: kernel-wasm <kernel-wasm@localhost>
Date: Mon, 16 Nov 2026 16:06:57 +0000
Subject: [PATCH] mm: allow percpu-km on SMP with a flat vmalloc

An architecture whose vmalloc returns directly mapped memory
(VMALLOC_FLAT) cannot vmap() the scattered pages that percpu-vm maps
into each chunk. percpu-km allocates every chunk as one contiguous
block instead and only needs a single group, which a UMA machine
has. Let such an SMP architecture use it.
---
 mm/Kconfig | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/mm/Kconfig b/mm/Kconfig
index 68ba95db79b..cbd89fd5289 100644
--- a/mm/Kconfig
+++ b/mm/Kconfig
@@ -1041,10 +1041,12 @@ config VMALLOC_FLAT
 	bool
 
 #
-# UP and nommu archs use km based percpu allocator
+# UP and nommu archs use km based percpu allocator, and so do SMP archs
+# whose vmalloc returns directly mapped memory (VMALLOC_FLAT), which cannot
+# vmap() the scattered pages percpu-vm needs
 #
 config NEED_PER_CPU_KM
-	depends on !SMP || !MMU
+	depends on !SMP || !MMU || VMALLOC_FLAT
 	bool
 	default y
 
-- 
2.56.0

