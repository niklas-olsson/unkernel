From f9b6646346065d22b151c0771a1a0d52a32ff8c1 Mon Sep 17 00:00:00 2001
From: kernel-wasm <kernel-wasm@localhost>
Date: Mon, 16 Nov 2026 14:54:54 +0000
Subject: [PATCH] wasm: make atomic_read and atomic_set plain accesses

atomic_read() and atomic_set() have no ordering: they are READ_ONCE() and
WRITE_ONCE() on the counter, as in asm-generic/atomic.h. The seq_cst
__atomic builtins made them i32/i64.atomic.load and .store with
KW_ATOMICS=1, and V8 compiles a seq_cst atomic store to xchg on x86
(about 4 ns against 0.2 for a plain store). An anonymous page fault does
three of them (the rwsem owner, the new folio's refcount and mapcount).
---
 arch/wasm/include/asm/atomic.h | 15 +++++++++++----
 1 file changed, 11 insertions(+), 4 deletions(-)

diff --git a/arch/wasm/include/asm/atomic.h b/arch/wasm/include/asm/atomic.h
index 22d5070de78..147aa15e682 100644
--- a/arch/wasm/include/asm/atomic.h
+++ b/arch/wasm/include/asm/atomic.h
@@ -4,9 +4,16 @@
 #define _ASM_WASM_ATOMIC_H
 
 #include <asm/cmpxchg.h>
+#include <asm/rwonce.h>
 
-#define arch_atomic_read(v)			__atomic_load_n(&((v)->counter), __ATOMIC_SEQ_CST)
-#define arch_atomic_set(v, i)			__atomic_store_n(&((v)->counter), (i), __ATOMIC_SEQ_CST)
+/*
+ * atomic_read() and atomic_set() are relaxed, so they are READ_ONCE() and
+ * WRITE_ONCE(), which SMP relies on being single-copy atomic anyway. With
+ * wasm atomics a seq_cst store would be an xchg on x86 hosts (about 4 ns
+ * in V8, against 0.2 for a plain store).
+ */
+#define arch_atomic_read(v)			READ_ONCE((v)->counter)
+#define arch_atomic_set(v, i)			WRITE_ONCE((v)->counter, (i))
 
 #define arch_atomic_cmpxchg(v, old, new)	arch_cmpxchg(&((v)->counter), old, new)
 #define arch_atomic_xchg(v, new)		arch_xchg(&((v)->counter), new)
@@ -37,8 +44,8 @@
 
 #define ATOMIC64_INIT(i) { (i) }
 
-#define arch_atomic64_read(v)			__atomic_load_n(&((v)->counter), __ATOMIC_SEQ_CST)
-#define arch_atomic64_set(v, i)			__atomic_store_n(&((v)->counter), (i), __ATOMIC_SEQ_CST)
+#define arch_atomic64_read(v)			READ_ONCE((v)->counter)
+#define arch_atomic64_set(v, i)			WRITE_ONCE((v)->counter, (i))
 
 #define arch_atomic64_cmpxchg(v, old, new)	arch_cmpxchg(&((v)->counter), old, new)
 #define arch_atomic64_xchg(v, new)		arch_xchg(&((v)->counter), new)
