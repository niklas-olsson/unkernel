+#ifdef CONFIG_SMP
+/*
+ * With @t pinned (task_call_func(): its wakeup, switch-in and switch-out
+ * held off): off its CPU, its next switch-in starts a fresh stack; still
+ * on it (on its way out after parking, or woken in kw_park_self()'s loop),
+ * it goes on on its old stack, which marking it would orphan.
+ */
