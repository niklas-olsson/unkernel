diff --git a/arch/wasm/kernel/irq.c b/arch/wasm/kernel/irq.c
index 1f2055d28c0..477eda768e2 100644
--- a/arch/wasm/kernel/irq.c
+++ b/arch/wasm/kernel/irq.c
@@ -48,6 +48,19 @@ void kw_irq_raise(int cpu, u32 bits)
 	__builtin_wasm_memory_atomic_notify((int *)word, ~0U);
 }
 
+/*
+ * A restored snapshot, on CPU 0 before the others start again: what their
+ * words held (a kick at most: a CPU held at the snapshot point takes no
+ * other IPI) belonged to the old session. The host clears CPU 0's.
+ */
+void kw_irq_words_reset(void)
+{
+	int cpu;
+
+	for (cpu = 1; cpu < NR_CPUS; cpu++)
+		WRITE_ONCE(kw_irq_words[cpu].pending, 0);
+}
+
 static u32 *kw_this_irq_word(void)
 {
 	u32 *word;
@@ -150,12 +163,22 @@ void arch_cpu_idle(void)
 	/*
 	 * Every other task is parked (park.c). Nothing is runnable, and with
 	 * interrupts off nothing can become so: this is the consistent point.
+	 * SMP: once CPU 0 holds every other CPU here (park.c, the rendezvous).
 	 */
 	if (unlikely(READ_ONCE(kw_park_final))) {
+#ifdef CONFIG_SMP
+		if (kw_park_rendezvous())
+			return;
+		/* Held for a while, perhaps: the timer may be due by now. */
+		timeout = wasm_timer_timeout();
+		if (timeout < 0 || timeout > KW_PARK_POLL_NS)
+			timeout = KW_PARK_POLL_NS;
+#else
 		state = irqentry_enter(&regs);
 		kw_park_idle();
 		irqentry_exit(&regs, state);
 		return;
+#endif
 	}
 
 #ifdef CONFIG_SMP
