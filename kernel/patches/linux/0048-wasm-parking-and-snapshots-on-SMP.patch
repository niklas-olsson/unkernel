 arch/wasm/kernel/entry.S     |  37 +-
 arch/wasm/kernel/irq.c       |  23 ++
 arch/wasm/kernel/park.c      | 702 ++++++++++++++++++++++++++++++++---
 arch/wasm/kernel/process.c   |  29 +-
 arch/wasm/kernel/smp.c       |  20 +
 9 files changed, 803 insertions(+), 66 deletions(-)

diff --git a/arch/wasm/Kconfig b/arch/wasm/Kconfig
index e8846e18f69..27dd1dde5cd 100644
--- a/arch/wasm/Kconfig
+++ b/arch/wasm/Kconfig
@@ -61,13 +61,13 @@ config SMP
 	  (wasm_cpu_count(), at most NR_CPUS). Needs a host that starts one
 	  worker per CPU and kwemu built with atomics
 	  (zig build -Dkwemu-atomics=true). Parking and snapshots
-	  (KW_PARK) are not available on SMP.
+	  (KW_PARK) work on SMP too; a snapshot restores only with the
+	  CPU count it was saved with.
 
-# Parking every task on demand (arch/wasm/kernel/park.c, linux/kw_park.h).
-# It assumes one CPU (kernel.md, Parking).
+# Parking every task on demand (arch/wasm/kernel/park.c, linux/kw_park.h),
+# and the snapshots built on it (kernel.md, Parking).
 config KW_PARK
 	def_bool y
-	depends on !SMP
 
 config 64BIT
 	def_bool y
diff --git a/arch/wasm/include/asm/park.h b/arch/wasm/include/asm/park.h
index 55f55c238c3..9525858d731 100644
--- a/arch/wasm/include/asm/park.h
+++ b/arch/wasm/include/asm/park.h
@@ -5,14 +5,24 @@
 
 #include <linux/compiler.h>
 #include <linux/linkage.h>
+#include <linux/types.h>
 
-/* thread_struct.park_state */
+/*
+ * thread_struct.park_state. A task that is still KW_PARK_PARKED when it
+ * starts on a fresh stack was woken after a restore before kwparkd resumed
+ * everything (park.c, kw_park_resume()).
+ */
 #define KW_PARK_NONE		0
 #define KW_PARK_PARKED		1	/* asleep in kw_park_self(), stack not needed */
 #define KW_PARK_RESUMING	2	/* resumes in kw_park_resume() on a fresh stack */
 
 struct task_struct;
 
+#ifdef CONFIG_SMP
+/* How long an idle CPU waits at most while kw_park_final is set (irq.c). */
+#define KW_PARK_POLL_NS		1000000
+#endif
+
 #ifdef CONFIG_KW_PARK
 /* Set while user tasks are asked to park at the top of user_mode_loop(). */
 extern int kw_park_users;
@@ -23,14 +33,27 @@ extern int kw_park_final;
 void kw_park_request(void);
 /* user_mode_loop(), interrupts disabled: park this user task. */
 void kw_park_user(void);
-/* __ret_from_fork() of a task whose park_state is KW_PARK_RESUMING. */
+/* __ret_from_fork() of a task whose park_state is not KW_PARK_NONE. */
 void __noreturn kw_park_resume(struct task_struct *prev);
+/* kw_resume (entry.S): a restored snapshot starts here, on CPU 0. */
+asmlinkage void __noreturn __kw_resume(void);
+#ifdef CONFIG_SMP
+/*
+ * arch_cpu_idle(), interrupts off, once kw_park_final is set: the
+ * rendezvous (CPU 0 leads, the others are held). False: wait in the idle
+ * path (at most KW_PARK_POLL_NS) and come back.
+ */
+bool kw_park_rendezvous(void);
+/*
+ * kw_secondary_resume (entry.S, smp.c): another CPU of a restored snapshot,
+ * started again by __kw_resume(), runs its idle task on from here.
+ */
+void __noreturn kw_park_cpu_resume(unsigned int cpu);
+#else
 /* arch_cpu_idle(), within irqentry_enter(), once kw_park_final is set. */
 void kw_park_idle(void);
-/* kw_resume (entry.S): a restored snapshot starts here. */
-asmlinkage void __noreturn __kw_resume(void);
+#endif
 #else
-/* SMP: no parking (kernel.md, Parking). */
 static const int kw_park_users;
 static const int kw_park_final;
 static inline void kw_park_user(void)
@@ -44,6 +67,11 @@ static inline void kw_park_resume(struct task_struct *prev)
 static inline void kw_park_idle(void)
 {
 }
+
+static inline bool kw_park_rendezvous(void)
+{
+	return true;
+}
 #endif
 
 #endif /* _ASM_WASM_PARK_H */
