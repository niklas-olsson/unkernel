 void __init kw_smp_init_cpus(void);
 /* kw_secondary_entry (entry.S): a secondary CPU's idle task starts here. */
 asmlinkage void __noreturn kw_secondary_start(void);
+/* kw_secondary_resume (entry.S): the same CPU in a restored snapshot. */
+asmlinkage void __noreturn kw_secondary_restart(void);
+/* A restored snapshot (park.c): forget every CPU's stacks to drop (process.c). */
+void kw_stack_drops_reset(void);
