diff --git a/arch/wasm/include/asm/wasm.h b/arch/wasm/include/asm/wasm.h
index 9238a99bc2e..e6a389f92aa 100644
--- a/arch/wasm/include/asm/wasm.h
+++ b/arch/wasm/include/asm/wasm.h
@@ -100,8 +100,10 @@ int wasm_cpu_count(void)
 /*
  * Start CPU @cpu: the host creates another instance of this module on the
  * same memory, in its own thread (a worker), and calls the export
- * kw_secondary_entry(@idle) there. Returns 0, or a negative errno if it
- * cannot. Called from __cpu_up() on CPU 0.
+ * kw_secondary_entry(@idle) there, or kw_secondary_resume(@idle) in a
+ * restored snapshot (the host knows it restored one). Returns 0, or a
+ * negative errno if it cannot. Called on CPU 0 from __cpu_up(), and from
+ * __kw_resume() for each CPU that was online (park.c).
  */
 int wasm_cpu_start(int cpu, struct task_struct *idle)
 	__unkernel_import(wasm_cpu_start);
diff --git a/arch/wasm/kernel/entry.S b/arch/wasm/kernel/entry.S
index 9d2b7aeb433..7b3505258a4 100644
--- a/arch/wasm/kernel/entry.S
+++ b/arch/wasm/kernel/entry.S
@@ -68,7 +68,8 @@ wasm_arch_switch:
 /*
  * kw_resume(): entry point of a restored snapshot, called by the host on a
  * fresh Wasm stack (JSPI "promising" export) instead of _start, after it
- * copied the saved memory into the new instance's. Runs the idle task.
+ * copied the saved memory into the new instance's. Runs CPU 0's idle task
+ * (on SMP, __kw_resume() starts the other CPUs again: kw_secondary_resume).
  */
 .functype __kw_resume() -> ()
 .globl kw_resume
@@ -81,6 +82,12 @@ kw_resume:
 	iLONG.const init_stack+THREAD_STACK_START
 	global.set __stack_pointer
 
+#ifdef CONFIG_SMP
+	/* A global of the instance, as _start (head.S) sets it. */
+	iLONG.const wasm_host_irqs
+	global.set kw_irq_word
+#endif
+
 	call __kw_resume
 	unreachable
 	end_function
@@ -112,6 +119,34 @@ kw_secondary_entry:
 	call kw_secondary_start
 	unreachable
 	end_function
+
+#ifdef CONFIG_KW_PARK
+/*
+ * kw_secondary_resume(idle): as kw_secondary_entry, for a CPU of a
+ * restored snapshot: the host starts it again when __kw_resume() asks
+ * (wasm_cpu_start() in a restored kernel), and its idle task runs on in
+ * kw_secondary_restart() without the bring-up. Never returns.
+ */
+.functype kw_secondary_restart() -> ()
+.globl kw_secondary_resume
+kw_secondary_resume:
+	.functype kw_secondary_resume(iLONG) -> ()
+
+	local.get 0
+	global.set current
+
+	local.get 0
+	iLONG.const zeroptr+TASK_STRUCT_STACK
+	iLONG.add
+	iLONG.load 0
+	iLONG.const zeroptr+THREAD_STACK_START
+	iLONG.add
+	global.set __stack_pointer
+
+	call kw_secondary_restart
+	unreachable
+	end_function
+#endif
 #endif
 
