+#ifdef CONFIG_SMP
+/*
+ * The rendezvous. kw_park_round names the current round (never 0); a CPU
+ * that checked in for it stores it in its slot, and CPU 0 claims the slot
+ * by setting KW_PARK_CLAIMED (a held CPU withdraws by clearing it while
+ * unclaimed: one cmpxchg wins). A new round number releases every held
+ * CPU. The deadline and the round's start are CPU 0's (written by kwparkd
+ * before it sets kw_park_final).
+ */
+#define KW_PARK_TIMEOUT_NS	(2 * NSEC_PER_SEC)
+#define KW_PARK_ROUND_NS	(5 * NSEC_PER_MSEC)
+#define KW_PARK_CLAIMED		0x80000000U
+
+static u32 kw_park_round;
+static struct {
+	u32 round;
+} ____cacheline_aligned kw_park_slots[NR_CPUS];
+static u64 kw_park_deadline, kw_park_round_t0, kw_park_window;
+/* The CPU that had not checked in when CPU 0 last looked, or -1. */
+static int kw_park_missing;
+/* The rendezvous failed: kwparkd resumes everything (kw_park_abort()). */
+static int kw_park_aborted;
+#endif
+
 static int kw_parkd_fn(void *unused);
 
 static BLOCKING_NOTIFIER_HEAD(kw_park_restore_chain);
@@ -154,32 +209,91 @@ static void kw_park_finish(int result)
 	WRITE_ONCE(kw_park_done, kw_park_cur);
 }
 
+#ifdef CONFIG_SMP
+static u32 kw_park_next_round(void)
+{
+	u32 r = (READ_ONCE(kw_park_round) + 1) & ~KW_PARK_CLAIMED;
+
+	return r ?: 1;
+}
+
+/* kwparkd parked last: start the rendezvous and wake every idle CPU for it. */
+static void kw_park_start_final(void)
+{
+	u64 now = ktime_get_mono_fast_ns();
+	int cpu;
+
+	kw_park_deadline = max(kw_park_t0 + KW_PARK_TIMEOUT_NS, now + 20 * NSEC_PER_MSEC);
+	kw_park_round_t0 = now;
+	kw_park_window = KW_PARK_ROUND_NS;
+	kw_park_missing = -1;
+	WRITE_ONCE(kw_park_round, kw_park_next_round());
+	smp_store_release(&kw_park_final, 1);
+	/* An atomic RMW and a notify each: idle CPUs leave their wait and come back. */
+	for_each_online_cpu(cpu)
+		kw_irq_raise(cpu, BIT(KW_IPI_KICK));
+}
+#else
+static void kw_park_start_final(void)
+{
+	WRITE_ONCE(kw_park_final, 1);
+}
+#endif
