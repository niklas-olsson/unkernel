From 8d66fafc644e76c693d0e3073e4a73711b58a293 Mon Sep 17 00:00:00 2001
From: kernel-wasm <kernel-wasm@localhost>
Date: Mon, 16 Nov 2026 20:16:03 +0000
Subject: [PATCH] wasm: kwfb on SMP

Open, release and a mode change (process context, under info->lock) ask
for the mode and attach the pixels through kw_host_call(), so the
imports run on CPU 0. The host reads the pixels while other CPUs draw,
as on UP while it runs. The UP build is unchanged.
---
 drivers/video/fbdev/kwfb.c | 52 ++++++++++++++++++++++++++++++++------
 1 file changed, 44 insertions(+), 8 deletions(-)

diff --git a/drivers/video/fbdev/kwfb.c b/drivers/video/fbdev/kwfb.c
index f66e8273752..233cf91522c 100644
--- a/drivers/video/fbdev/kwfb.c
+++ b/drivers/video/fbdev/kwfb.c
@@ -41,6 +41,11 @@
  * size is halved until it succeeds. A mapping holds a reference to its
  * file, so the buffer is freed only after the last mapping is gone too;
  * mappings are counted (vm_ops) for the reallocation rule.
+ *
+ * SMP: the host's imports answer on CPU 0 alone; open, release and a mode
+ * change (all in process context, under info->lock) ask and attach through
+ * kw_host_call(). The host reads the pixels while other CPUs draw, as on
+ * UP while it runs: tearing is possible, as without vsync anywhere.
  */
 
 #include <linux/platform_device.h>
@@ -76,6 +81,42 @@ u32 wasm_driver_fb_attach(void *pixels, u32 width, u32 height, u32 stride,
 			  u32 format)
 	__unkernel_import(wasm_driver_fb_attach);
 
+#ifdef CONFIG_SMP
+static long kwfb_mode_fn(void *unused)
+{
+	return wasm_driver_fb_mode();
+}
+
+static u32 kwfb_host_mode(void)
+{
+	return kw_host_call(kwfb_mode_fn, NULL);
+}
+
+struct kwfb_attach_args {
+	void *pixels;
+	u32 width, height, stride, format;
+};
+
+static long kwfb_attach_fn(void *arg)
+{
+	struct kwfb_attach_args *a = arg;
+
+	return wasm_driver_fb_attach(a->pixels, a->width, a->height, a->stride,
+				     a->format);
+}
+
+static u32 kwfb_host_attach(void *pixels, u32 width, u32 height, u32 stride,
+			    u32 format)
+{
+	struct kwfb_attach_args a = { pixels, width, height, stride, format };
+
+	return kw_host_call(kwfb_attach_fn, &a);
+}
+#else
+#define kwfb_host_mode		wasm_driver_fb_mode
+#define kwfb_host_attach	wasm_driver_fb_attach
+#endif
+
 struct kwfb {
 	struct fb_info *info;
 	unsigned int users;	/* open files, under info->lock */
@@ -161,9 +202,9 @@ static void kwfb_install(struct fb_info *info, void *p, size_t size, u32 w,
 	info->fix.smem_len = w * h * 4;
 	info->fix.line_length = w * 4;
 	if (p)
-		mm = wasm_driver_fb_attach(p, w, h, w * 4, KWFB_FORMAT);
+		mm = kwfb_host_attach(p, w, h, w * 4, KWFB_FORMAT);
 	else
-		wasm_driver_fb_attach(NULL, 0, 0, 0, 0);
+		kwfb_host_attach(NULL, 0, 0, 0, 0);
 	kwfb.mm_w = mm >> 16;
 	kwfb.mm_h = mm & 0xffff;
 	kwfb_set_var(&info->var, w, h);
@@ -182,7 +223,7 @@ static int kwfb_open(struct fb_info *info, int user)
 		return -EBUSY;
 	if (kwfb.users++)
 		goto claim;
-	mode = wasm_driver_fb_mode();
+	mode = kwfb_host_mode();
 	w = mode ? mode >> 16 : KWFB_DEF_W;
 	h = mode ? mode & 0xffff : KWFB_DEF_H;
 	kwfb_fit(&w, &h);
@@ -300,11 +341,6 @@ static int __init kwfb_init(void)
 		pr_info("kwfb: no host display\n");
 		return 0;
 	}
-	/* SMP: not yet; its host imports answer on CPU 0 alone, from any context. */
-	if (IS_ENABLED(CONFIG_SMP)) {
-		pr_warn("kwfb: the display is not supported on SMP kernels yet\n");
-		return 0;
-	}
 
 	/*
 	 * A parent on the platform bus: the X.Org fbdev driver skips a
-- 
