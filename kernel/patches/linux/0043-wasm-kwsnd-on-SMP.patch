From c3056b2ff073ce2661180ca268258a953409cd1b Mon Sep 17 00:00:00 2001
From: kernel-wasm <kernel-wasm@localhost>
Date: Mon, 16 Nov 2026 20:16:04 +0000
Subject: [PATCH] wasm: kwsnd on SMP

The playback timer is pinned to CPU 0, where the host's imports answer.
Open, prepare and close send their event through kw_host_call(). The
trigger runs in atomic context on any CPU: on another CPU a start or
stop leaves its event in the stream and queues a work item on CPU 0,
which sends it and starts the timer. Whatever sends an event first
sends the ones left (between two prepares a stream starts and stops at
most once), so the host sees them in order, and the tick sends a start
before its frames. The UP build is unchanged.
---
 sound/drivers/kwsnd.c | 122 ++++++++++++++++++++++++++++++++++++++----
 1 file changed, 113 insertions(+), 9 deletions(-)

diff --git a/sound/drivers/kwsnd.c b/sound/drivers/kwsnd.c
index d8e0be82cbb..403d3a76805 100644
--- a/sound/drivers/kwsnd.c
+++ b/sound/drivers/kwsnd.c
@@ -45,6 +45,14 @@
  * The host is told about every state change with wasm_driver_sound_event():
  * open, prepare (rate, channels, format), start, stop (drain or not) and
  * close. No import suspends.
+ *
+ * SMP: the host's imports answer on CPU 0 alone. The timer runs there
+ * (pinned), open, prepare and close send their event through
+ * kw_host_call(), and a start or stop on another CPU (the trigger, in
+ * atomic context) leaves its event in the stream for a work item on CPU
+ * 0, which sends it and starts the timer. Everything that sends one first
+ * sends what is left (kwsnd_flush()), so the host sees them in order; a
+ * stream starts at most once and stops at most once between two prepares.
  */
 
 #include <linux/hrtimer.h>
@@ -52,6 +60,7 @@
 #include <linux/math64.h>
 #include <linux/module.h>
 #include <linux/slab.h>
+#include <linux/workqueue.h>
 #include <sound/core.h>
 #include <sound/pcm.h>
 #include <asm/wasm.h>
@@ -85,8 +94,75 @@ struct kwsnd_stream {
 	u64 tick_ns;
 	u32 burst;		/* most frames one tick hands over */
 	bool running;
+#ifdef CONFIG_SMP
+	/* Left by the trigger on another CPU for CPU 0 (stream lock). */
+	bool ev_start, ev_stop, ev_drained;
+	struct work_struct kick;	/* sends them on CPU 0, starts the timer */
+#endif
 };
 
+#ifdef CONFIG_SMP
+/* The timer stays on CPU 0, where the host's imports answer. */
+#define KWSND_TIMER_MODE	HRTIMER_MODE_REL_PINNED
+
+/* CPU 0, stream lock: send the events the trigger left, in order. */
+static void kwsnd_flush(struct kwsnd_stream *s)
+{
+	if (s->ev_start) {
+		s->ev_start = false;
+		wasm_driver_sound_event(KWSND_EV_START, 0, 0, 0);
+	}
+	if (s->ev_stop) {
+		s->ev_stop = false;
+		wasm_driver_sound_event(KWSND_EV_STOP, s->ev_drained, 0, 0);
+	}
+}
+
+static void kwsnd_kick(struct work_struct *work)
+{
+	struct kwsnd_stream *s = container_of(work, struct kwsnd_stream, kick);
+	unsigned long flags;
+
+	snd_pcm_stream_lock_irqsave(s->substream, flags);
+	kwsnd_flush(s);
+	if (s->running && !hrtimer_active(&s->timer))
+		hrtimer_start(&s->timer, ns_to_ktime(s->tick_ns), KWSND_TIMER_MODE);
+	snd_pcm_stream_unlock_irqrestore(s->substream, flags);
+}
+
+struct kwsnd_call {
+	struct kwsnd_stream *s;
+	u32 event, rate, channels, format;
+};
+
+static long kwsnd_event_fn(void *arg)
+{
+	struct kwsnd_call *c = arg;
+	unsigned long flags;
+
+	if (c->s) {
+		snd_pcm_stream_lock_irqsave(c->s->substream, flags);
+		kwsnd_flush(c->s);
+		snd_pcm_stream_unlock_irqrestore(c->s->substream, flags);
+	}
+	wasm_driver_sound_event(c->event, c->rate, c->channels, c->format);
+	return 0;
+}
+
+/* An event from process context (open, prepare, close), sent on CPU 0. */
+static void kwsnd_event(struct kwsnd_stream *s, u32 event, u32 rate,
+			u32 channels, u32 format)
+{
+	struct kwsnd_call c = { s, event, rate, channels, format };
+
+	kw_host_call(kwsnd_event_fn, &c);
+}
+#else
+#define KWSND_TIMER_MODE	HRTIMER_MODE_REL
+#define kwsnd_event(s, event, rate, channels, format) \
+	wasm_driver_sound_event(event, rate, channels, format)
+#endif
+
 static const struct snd_pcm_hardware kwsnd_hw = {
 	.info = SNDRV_PCM_INFO_MMAP | SNDRV_PCM_INFO_MMAP_VALID |
 		SNDRV_PCM_INFO_INTERLEAVED | SNDRV_PCM_INFO_BLOCK_TRANSFER,
@@ -131,6 +207,9 @@ static enum hrtimer_restart kwsnd_tick(struct hrtimer *timer)
 	unsigned long flags;
 
 	snd_pcm_stream_lock_irqsave(s->substream, flags);
+#ifdef CONFIG_SMP
+	kwsnd_flush(s);		/* a start before its frames */
+#endif
 	if (!s->running)
 		goto stopped;
 
@@ -217,7 +296,10 @@ static int kwsnd_open(struct snd_pcm_substream *substream)
 		return err;
 	}
 	runtime->private_data = s;
-	wasm_driver_sound_event(KWSND_EV_OPEN, 0, 0, 0);
+#ifdef CONFIG_SMP
+	INIT_WORK(&s->kick, kwsnd_kick);
+#endif
+	kwsnd_event(NULL, KWSND_EV_OPEN, 0, 0, 0);
 	return 0;
 }
 
@@ -225,9 +307,16 @@ static int kwsnd_close(struct snd_pcm_substream *substream)
 {
 	struct kwsnd_stream *s = substream->runtime->private_data;
 
+#ifdef CONFIG_SMP
+	cancel_work_sync(&s->kick);	/* its events go with the close */
+	hrtimer_cancel(&s->timer);
+	kwsnd_event(s, KWSND_EV_CLOSE, 0, 0, 0);
+	kfree(s);
+#else
 	hrtimer_cancel(&s->timer);
 	kfree(s);
 	wasm_driver_sound_event(KWSND_EV_CLOSE, 0, 0, 0);
+#endif
 	return 0;
 }
 
@@ -238,13 +327,16 @@ static int kwsnd_prepare(struct snd_pcm_substream *substream)
 	u64 period_ns = div_u64((u64)runtime->period_size * NSEC_PER_SEC,
 				runtime->rate);
 
+#ifdef CONFIG_SMP
+	cancel_work_sync(&s->kick);	/* its events go before the prepare */
+#endif
 	hrtimer_cancel(&s->timer);
 	s->tick_ns = clamp_t(u64, period_ns, KWSND_TICK_MIN_NS, KWSND_TICK_MAX_NS);
 	s->burst = min_t(u64, runtime->buffer_size - 1,
 			 div_u64(3 * s->tick_ns * runtime->rate, NSEC_PER_SEC));
 	runtime->delay = 0;
-	wasm_driver_sound_event(KWSND_EV_PREPARE, runtime->rate,
-				runtime->channels, runtime->format);
+	kwsnd_event(s, KWSND_EV_PREPARE, runtime->rate, runtime->channels,
+		    runtime->format);
 	return 0;
 }
 
@@ -264,12 +356,29 @@ static int kwsnd_trigger(struct snd_pcm_substream *substream, int cmd)
 		s->played = 0;
 		s->pos0 = runtime->status->hw_ptr % runtime->buffer_size;
 		s->running = true;
-		hrtimer_start(&s->timer, ns_to_ktime(s->tick_ns), HRTIMER_MODE_REL);
+#ifdef CONFIG_SMP
+		if (smp_processor_id()) {
+			s->ev_start = true;
+			queue_work_on(0, system_highpri_wq, &s->kick);
+			return 0;
+		}
+		kwsnd_flush(s);
+#endif
+		hrtimer_start(&s->timer, ns_to_ktime(s->tick_ns), KWSND_TIMER_MODE);
 		wasm_driver_sound_event(KWSND_EV_START, 0, 0, 0);
 		return 0;
 	case SNDRV_PCM_TRIGGER_STOP:
 		s->running = false;
 		hrtimer_try_to_cancel(&s->timer);
+#ifdef CONFIG_SMP
+		if (smp_processor_id()) {
+			s->ev_stop = true;
+			s->ev_drained = runtime->state == SNDRV_PCM_STATE_DRAINING;
+			queue_work_on(0, system_highpri_wq, &s->kick);
+			return 0;
+		}
+		kwsnd_flush(s);
+#endif
 		wasm_driver_sound_event(KWSND_EV_STOP,
 					runtime->state == SNDRV_PCM_STATE_DRAINING,
 					0, 0);
@@ -306,11 +415,6 @@ static int __init kwsnd_init(void)
 		pr_info("kwsnd: no host audio\n");
 		return 0;
 	}
-	/* SMP: not yet; its host imports answer on CPU 0 alone, from any context. */
-	if (IS_ENABLED(CONFIG_SMP)) {
-		pr_warn("kwsnd: sound is not supported on SMP kernels yet\n");
-		return 0;
-	}
 	err = snd_card_new(NULL, -1, "kwsnd", THIS_MODULE, 0, &card);
 	if (err)
 		return err;
-- 
2.56.0

