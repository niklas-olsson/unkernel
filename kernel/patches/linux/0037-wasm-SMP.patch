+			unsigned long end)
+{
+	struct kw_flush f = { .mm = mm, .start = start, .end = end };
+	int self = get_cpu(), cpu;
+	cpumask_t wait;
+
+	kw_flush_local(&f);
+	cpumask_clear(&wait);
+	for_each_cpu(cpu, mm_cpumask(mm)) {
+		if (cpu == self)
+			continue;
+		if (READ_ONCE(per_cpu(kw_tlb_lazy, cpu))) {
+			WRITE_ONCE(per_cpu(kw_tlb_stale, cpu), 1);
+			smp_mb();
+			if (READ_ONCE(per_cpu(kw_tlb_lazy, cpu)))
+				continue;
+		}
+		__cpumask_set_cpu(cpu, &wait);
+	}
+	if (!cpumask_empty(&wait))
+		smp_call_function_many(&wait, kw_flush_local, &f, true);
+	put_cpu();
+}
+
+void flush_tlb_all(void)
+{
+	struct kw_flush f = { };
+
+	on_each_cpu(kw_flush_local, &f, 1);
+}
+
+void flush_tlb_mm(struct mm_struct *mm)
+{
+	kw_flush_mm(mm, 0, 0);
+}
+
+void flush_tlb_page(struct vm_area_struct *vma, unsigned long addr)
+{
+	kw_flush_mm(vma->vm_mm, addr & PAGE_MASK, (addr & PAGE_MASK) + PAGE_SIZE);
+}
+
+void flush_tlb_range(struct vm_area_struct *vma, unsigned long start,
+		     unsigned long end)
+{
+	kw_flush_mm(vma->vm_mm, start, end);
+}
+
+/*
+ * A PTE that became present, writable, young or dirty with the same page
+ * (the cases that end here, and the spurious-fault flush) needs no other
+ * CPU's flush: kwemu caches only translations that allowed the access
+ * when they were filled, never a non-present or narrower entry that would
+ * hide the new one (separate read and write TLBs; a miss walks the table),
+ * so another CPU at worst walks again. Every change that removes access or
+ * moves the page flushes first (ptep_clear_flush(), flush_tlb_*()). The
+ * local flush only mirrors riscv's update_mmu_cache_range().
+ */
+void update_mmu_cache_range(struct vm_fault *vmf, struct vm_area_struct *vma,
+			    unsigned long addr, pte_t *ptep, unsigned int nr)
+{
+	if (vma->vm_mm == kw_loaded_mm)
+		kw_flush_tlb_range(wasm_kw_cpu, addr,
+				   addr + (unsigned long)nr * PAGE_SIZE);
+}
+
+void kw_flush_tlb_fix_spurious_fault(struct vm_area_struct *vma,
+				     unsigned long addr)
+{
+	if (vma->vm_mm == kw_loaded_mm)
+		kw_flush_tlb_range(wasm_kw_cpu, addr & PAGE_MASK,
+				   (addr & PAGE_MASK) + PAGE_SIZE);
+}
+
+/*
+ * The fault path's update (pgtable.h; generic: compare, then a plain store
+ * of @entry, built from an older read): keep a D bit set since.
+ */
+int ptep_set_access_flags(struct vm_area_struct *vma, unsigned long address,
+			  pte_t *ptep, pte_t entry, int dirty)
+{
+	unsigned long old = pte_val(READ_ONCE(*ptep)), new;
+
+	do {
+		new = pte_val(entry) | (old & _PAGE_DIRTY);
+		if (old == new)
+			return 0;
+	} while (!try_cmpxchg(&pte_val(*ptep), &old, new));
+	kw_flush_tlb_fix_spurious_fault(vma, address);
+	return 1;
+}
+
+/* riscv_flush_icache(): every CPU drops its decoded code. */
+void kw_flush_icache_all(void)
+{
+	flush_tlb_all();
+}
+#else
 void flush_tlb_all(void)
 {
 	kw_flush_tlb_all(wasm_kw_cpu);
@@ -78,11 +289,30 @@ void update_mmu_cache_range(struct vm_fault *vmf, struct vm_area_struct *vma,
 				   addr + (unsigned long)nr * PAGE_SIZE);
 }
 
+void kw_flush_icache_all(void)
+{
+	kw_flush_tlb_all(wasm_kw_cpu);
+}
+#endif
+
 /* mm teardown: never leave the emulator pointing at a freed page table. */
 void kw_mm_release(struct mm_struct *mm)
 {
+#ifdef CONFIG_SMP
+	int self = get_cpu();
+
+	if (mm == kw_loaded_mm) {
+		kw_set_pgd(wasm_kw_cpu, __pa(swapper_pg_dir));
+		cpumask_clear_cpu(self, mm_cpumask(mm));
+		kw_loaded_mm = &init_mm;
+	}
+	/* Another CPU switches away before its lazy reference goes. */
+	WARN_ON_ONCE(cpumask_any(mm_cpumask(mm)) < nr_cpu_ids);
+	put_cpu();
+#else
 	if (mm == kw_loaded_mm) {
 		kw_set_pgd(wasm_kw_cpu, __pa(swapper_pg_dir));
 		kw_loaded_mm = &init_mm;
 	}
+#endif
 }
