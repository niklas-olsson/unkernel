diff --git a/arch/wasm/Kconfig b/arch/wasm/Kconfig
index 1ed6743adce..e8846e18f69 100644
--- a/arch/wasm/Kconfig
+++ b/arch/wasm/Kconfig
@@ -36,6 +36,9 @@ config WASM
 	select VMALLOC_FLAT
 	select HAVE_ARCH_MMAP_RND_BITS
 	select LOCK_MM_AND_FIND_VMA
+	select GENERIC_SMP_IDLE_THREAD if SMP
+	select ARCH_USE_QUEUED_RWLOCKS if SMP
+	select ARCH_TASKS_STAY_ON_CPU if SMP
 
 # riscv64 ELF userspace runs on the kwemu software CPU with real page tables
 # (fork, mmap, copy-on-write). The original linux-wasm NOMMU mode (programs
@@ -43,12 +46,28 @@ config WASM
 config MMU
 	def_bool y
 
+# One instance of the kernel module per CPU, each on its own host thread
+# (a worker), all on one shared memory (KW_SHARED_MEMORY in the arch
+# Makefile). A task's wasm stack lives in the thread that started it, so
+# a task stays on that CPU (ARCH_TASKS_STAY_ON_CPU) except where it can
+# start again on a fresh stack: a user task on its way to user mode, a
+# kthread at a restart point. Interrupts and IPIs are bits in a word per CPU,
+# polled at user slice ends, in idle, when interrupts are enabled and in
+# cpu_relax(). Host devices stay on CPU 0.
 config SMP
-	bool
+	bool "Symmetric multi-processing (experimental)"
+	help
+	  Build a kernel that runs on as many CPUs as the host offers
+	  (wasm_cpu_count(), at most NR_CPUS). Needs a host that starts one
+	  worker per CPU and kwemu built with atomics
+	  (zig build -Dkwemu-atomics=true). Parking and snapshots
+	  (KW_PARK) are not available on SMP.
 
 # Parking every task on demand (arch/wasm/kernel/park.c, linux/kw_park.h).
+# It assumes one CPU (kernel.md, Parking).
 config KW_PARK
 	def_bool y
+	depends on !SMP
 
 config 64BIT
 	def_bool y
@@ -58,7 +77,9 @@ config HZ
 	default 100
 
 config NR_CPUS
-	int
+	int "Maximum number of CPUs (2-32)" if SMP
+	range 2 32 if SMP
+	default 16 if SMP
 	default 1
 
 config GENERIC_CSUM
diff --git a/arch/wasm/Makefile b/arch/wasm/Makefile
index 34e941e06b6..49049055794 100644
--- a/arch/wasm/Makefile
+++ b/arch/wasm/Makefile
@@ -10,6 +10,11 @@ KCFLAGS += -march=wasm64
 KAFLAGS += -march=wasm64
 KBUILD_LDFLAGS += -mwasm64
 
+# An SMP kernel (CONFIG_SMP) always links against a shared memory.
+ifeq ($(CONFIG_SMP),y)
+KW_SHARED_MEMORY := 1
+endif
+
 # Experimental (SMP groundwork; the kernel stays UP): KW_ATOMICS=1 builds
 # with the wasm atomics feature, so the __atomic_* builtins behind
 # atomic.h, cmpxchg.h and barrier.h become real atomic instructions.
diff --git a/arch/wasm/configs/kw_smp.config b/arch/wasm/configs/kw_smp.config
new file mode 100644
index 00000000000..749e2d12a01
--- /dev/null
+++ b/arch/wasm/configs/kw_smp.config
@@ -0,0 +1,4 @@
+# unkernel SMP build: merged over kw_defconfig (make kw_defconfig kw_smp.config).
+# One wasm instance per CPU on a shared memory; see arch/wasm/Kconfig, SMP.
+CONFIG_SMP=y
+CONFIG_NR_CPUS=16
diff --git a/arch/wasm/include/asm/entry-common.h b/arch/wasm/include/asm/entry-common.h
index 185b2ff8246..ea8e4a240f7 100644
--- a/arch/wasm/include/asm/entry-common.h
+++ b/arch/wasm/include/asm/entry-common.h
@@ -5,4 +5,31 @@
 
 #include <asm/stacktrace.h>
 
+#ifdef CONFIG_SMP
+/*
+ * A user task's stack lives in the host thread of its CPU; it may move to
+ * another CPU only at the reschedule on its way to user mode, and starts
+ * there on a fresh stack (process.c).
+ */
+void kw_exit_to_user_schedule(void);
+void kw_exit_to_user_move(void);
+#define arch_exit_to_user_mode_schedule kw_exit_to_user_schedule
+
+/*
+ * An affinity change that excludes the CPU (arch_stay_move()) or a better
+ * CPU named by the scheduler (arch_stay_move_to()) sets TIF_KW_MOVE.
+ */
+#define ARCH_EXIT_TO_USER_MODE_WORK	_TIF_KW_MOVE
+
+static inline void arch_exit_to_user_mode_work(struct pt_regs *regs,
+					       unsigned long ti_work)
+{
+	if (unlikely(ti_work & _TIF_KW_MOVE)) {
+		clear_thread_flag(TIF_KW_MOVE);
+		kw_exit_to_user_move();
+	}
+}
+#define arch_exit_to_user_mode_work arch_exit_to_user_mode_work
+#endif
+
 #endif /* _ASM_WASM_ENTRY_COMMON_H */
diff --git a/arch/wasm/include/asm/futex.h b/arch/wasm/include/asm/futex.h
index 298606ab13a..295105b9d6b 100644
--- a/arch/wasm/include/asm/futex.h
+++ b/arch/wasm/include/asm/futex.h
@@ -8,8 +8,13 @@
 #include <asm/errno.h>
 
 /*
- * Single CPU, no preemption, and user mode only runs when the kernel calls
- * kw_run(): plain read-modify-write on the translated address is atomic.
+ * Read-modify-write of a user word through its kernel address
+ * (kw_user_addr(), valid until the next poll point). On SMP user code on
+ * other CPUs updates the same word with AMOs and LR/SC (kwemu's atomics
+ * are wasm atomics on the same memory), so these are wasm atomics too,
+ * fully ordered as riscv's amo*.aqrl and lr/sc.aqrl. Without wasm atomics
+ * (UP) the compiler makes them plain loads and stores, which suffices:
+ * one CPU, no preemption, and user code only runs inside kw_run().
  */
 static inline int futex_atomic_cmpxchg_inatomic(u32 *uval, u32 __user *uaddr,
 						u32 oldval, u32 newval)
@@ -22,9 +27,9 @@ static inline int futex_atomic_cmpxchg_inatomic(u32 *uval, u32 __user *uaddr,
 	if (!p)
 		return -EFAULT;
 
-	*uval = *p;
-	if (*uval == oldval)
-		*p = newval;
+	*uval = oldval;
+	__atomic_compare_exchange_n(p, uval, newval, false, __ATOMIC_SEQ_CST,
+				    __ATOMIC_SEQ_CST);
 	return 0;
 }
 
@@ -39,22 +44,21 @@ static inline int arch_futex_atomic_op_inuser(int op, u32 oparg, int *oval,
 	if (!p)
 		return -EFAULT;
 
-	old = *p;
 	switch (op) {
 	case FUTEX_OP_SET:
-		*p = oparg;
+		old = __atomic_exchange_n(p, oparg, __ATOMIC_SEQ_CST);
 		break;
 	case FUTEX_OP_ADD:
-		*p = old + oparg;
+		old = __atomic_fetch_add(p, oparg, __ATOMIC_SEQ_CST);
 		break;
 	case FUTEX_OP_OR:
-		*p = old | oparg;
+		old = __atomic_fetch_or(p, oparg, __ATOMIC_SEQ_CST);
 		break;
 	case FUTEX_OP_ANDN:
-		*p = old & ~oparg;
+		old = __atomic_fetch_and(p, ~oparg, __ATOMIC_SEQ_CST);
 		break;
 	case FUTEX_OP_XOR:
-		*p = old ^ oparg;
+		old = __atomic_fetch_xor(p, oparg, __ATOMIC_SEQ_CST);
 		break;
 	default:
 		return -ENOSYS;
