+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * SMP: one instance of the kernel module per CPU, each in its own host
+ * thread, all on one shared memory. CPU 0 boots as on UP; __cpu_up() asks
+ * the host for another instance (wasm_cpu_start()), which enters at
+ * kw_secondary_entry (entry.S) with the CPU's idle task.
+ *
+ * IPIs are bits in the target's word of pending interrupts (irq.c,
+ * kw_irq_raise()), taken at its next poll point: a user slice end (kwemu
+ * polls the word every block), idle (where the sender's notify wakes it),
+ * an interrupt enable, or cpu_relax().
+ *
+ * A task's wasm stack lives in the thread of the CPU that started it, so
+ * the task is held there (migration-disabled from its first run,
+ * ARCH_TASKS_STAY_ON_CPU) except where the stack can be dropped: a user
+ * task at the reschedule on its way to user mode, a kthread at a restart
+ * point. Moved, it starts on a fresh stack (process.c).
+ */
+
+#include <linux/cpu.h>
+#include <linux/delay.h>
+#include <linux/interrupt.h>
+#include <linux/memblock.h>
+#include <linux/sched/mm.h>
+#include <linux/sched/task_stack.h>
+#include <linux/smp.h>
+#include <asm/irq.h>
+#include <asm/kwcpu.h>
+#include <asm/time.h>
+#include <asm/wasm.h>
+
+static DECLARE_COMPLETION(cpu_running);
+
+void __init kw_smp_init_cpus(void)
+{
+	int n = min_t(int, wasm_cpu_count(), nr_cpu_ids), cpu;
+
+	for (cpu = 1; cpu < n; cpu++) {
+		/* kwemu's state (KW_CPU_SIZE, 9 MiB) for each further CPU. */
+		kw_cpus[cpu] = memblock_alloc_raw(KW_CPU_SIZE, SMP_CACHE_BYTES);
+		if (!kw_cpus[cpu]) {
+			pr_warn("smp: no memory for CPU%d's kwemu state\n", cpu);
+			break;
+		}
+		set_cpu_possible(cpu, true);
+		set_cpu_present(cpu, true);
+	}
+}
+
+void __init smp_prepare_cpus(unsigned int max_cpus)
+{
+}
+
+void __init smp_cpus_done(unsigned int max_cpus)
+{
+}
+
+int __cpu_up(unsigned int cpu, struct task_struct *tidle)
+{
+	int ret;
+
+	tidle->thread_info.cpu = cpu;
+	ret = wasm_cpu_start(cpu, tidle);
+	if (ret) {
+		pr_crit("CPU%u: the host cannot start it (%d)\n", cpu, ret);
+		return ret;
+	}
+	/* The host starts a thread and instantiates the module: give it time. */
+	wait_for_completion_timeout(&cpu_running, secs_to_jiffies(30));
+	if (!cpu_online(cpu)) {
+		pr_crit("CPU%u: failed to come online\n", cpu);
+		return -EIO;
+	}
+	return 0;
