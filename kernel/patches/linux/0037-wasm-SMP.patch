diff --git a/arch/wasm/include/asm/irq.h b/arch/wasm/include/asm/irq.h
index 8614e54fe17..f8fb09f2579 100644
--- a/arch/wasm/include/asm/irq.h
+++ b/arch/wasm/include/asm/irq.h
@@ -17,15 +17,37 @@
 #define WASM_IRQ_VIRTIO			10	/* host: kwvirtio used buffers or a config change */
 #define WASM_IRQ_DROP_CACHES		11	/* host: with WASM_IRQ_SNAPSHOT, drop the caches first (park.c) */
 
+/*
+ * SMP: inter-processor interrupts are bits of the target CPU's pending word
+ * (CPU 0's is wasm_host_irqs, where the host sets the device bits above;
+ * the others' are kw_irq_words[]), set atomically by the sender, which then
+ * wakes the target (memory.atomic.notify).
+ */
+#define KW_IPI_RESCHEDULE		24
+#define KW_IPI_CALL_FUNC		25
+#define KW_IPI_STOP			26
+#define KW_IPI_MASK			(7U << KW_IPI_RESCHEDULE)
+
 #include <asm-generic/irq.h>
 
 #ifndef __ASSEMBLER__
+#include <linux/types.h>
+
 struct pt_regs;
 
 /* Run pending timer/host interrupts if irqs are enabled in @regs' context. */
 void wasm_poll_irqs(struct pt_regs *regs);
 /* Nanoseconds until the next timer expiry, -1 if none. */
 long long wasm_timer_timeout(void);
+
+#ifdef CONFIG_SMP
+/* @cpu's word of pending interrupts. */
+u32 *kw_irq_word_of(int cpu);
+/* Set @bits in @cpu's word and wake it (any context, any CPU). */
+void kw_irq_raise(int cpu, u32 bits);
+/* smp.c: run the IPIs in @bits (in interrupt context). */
+void kw_handle_ipis(u32 bits);
+#endif
 #endif
 
 #endif /* _ASM_WASM_IRQ_H */
diff --git a/arch/wasm/include/asm/irqflags.h b/arch/wasm/include/asm/irqflags.h
index 93987ef653f..c69c2059a09 100644
--- a/arch/wasm/include/asm/irqflags.h
+++ b/arch/wasm/include/asm/irqflags.h
@@ -4,13 +4,15 @@
 #define _ASM_WASM_IRQFLAGS_H
 
 /*
- * Uniprocessor; "interrupts" (timer expiry, host events) are only taken at
+ * "Interrupts" (timer expiry, host events, IPIs) are only taken at
  * well-defined poll points, so the irq state is just a flag.
  */
 #define ARCH_IRQ_DISABLED	0
 #define ARCH_IRQ_ENABLED	1
 
 #ifndef __ASSEMBLER__
+#ifndef CONFIG_SMP
+/* Uniprocessor: the flag is in memory, and nothing polls on enable. */
 extern unsigned long wasm_irq_flags;
 
 #define arch_local_save_flags arch_local_save_flags
@@ -24,7 +26,72 @@ static inline void arch_local_irq_restore(unsigned long flags)
 {
 	*(volatile unsigned long *)&wasm_irq_flags = flags;
 }
-#endif
+#else
+#include <asm/asm.h>
+
+/*
+ * SMP: the flag is a wasm global of the CPU's instance (entry.S), and so is
+ * the address of the CPU's word of pending interrupts (asm/irq.h). Another
+ * CPU waiting for an IPI to be handled (a TLB shootdown, a function call)
+ * needs this CPU to poll, so enabling interrupts delivers what is pending,
+ * as hardware would (kw_irq_enable_pending(), irq.c).
+ */
+__ASM_DECL(kw_irq_flags, "i32")
+__ASM_DECL(kw_irq_word, iLONG)
+
+#define arch_local_save_flags arch_local_save_flags
+static __always_inline unsigned long arch_local_save_flags(void)
+{
+	unsigned int flags;
+
+	__asm__ volatile("global.get kw_irq_flags\n\t"
+			 "local.set %0" : "=r"(flags));
+	return flags;
+}
+
+static __always_inline void kw_irq_flags_set(unsigned long flags)
+{
+	__asm__ volatile("local.get %0\n\t"
+			 "global.set kw_irq_flags" : : "r"((unsigned int)flags) : "memory");
+}
+
+/* This CPU's word of pending interrupts and IPIs (non-zero: something to take). */
+static __always_inline unsigned int kw_irq_pending(void)
+{
+	const volatile unsigned int *word;
+
+	__asm__ volatile("global.get kw_irq_word\n\t"
+			 "local.set %0" : "=r"(word));
+	return *word;
+}
+
+void kw_irq_enable_pending(void);
+
+#define arch_local_irq_restore arch_local_irq_restore
+static __always_inline void arch_local_irq_restore(unsigned long flags)
+{
+	if (flags == ARCH_IRQ_ENABLED && unlikely(kw_irq_pending()))
+		kw_irq_enable_pending();
+	else
+		kw_irq_flags_set(flags);
+}
+
+#define arch_local_irq_save arch_local_irq_save
+static __always_inline unsigned long arch_local_irq_save(void)
+{
+	unsigned long flags = arch_local_save_flags();
+
+	kw_irq_flags_set(ARCH_IRQ_DISABLED);
+	return flags;
+}
+
+#define arch_local_irq_disable arch_local_irq_disable
+static __always_inline void arch_local_irq_disable(void)
+{
+	kw_irq_flags_set(ARCH_IRQ_DISABLED);
+}
+#endif /* CONFIG_SMP */
+#endif /* __ASSEMBLER__ */
 
 #include <asm-generic/irqflags.h>
 
diff --git a/arch/wasm/include/asm/kw_emu.h b/arch/wasm/include/asm/kw_emu.h
index dbdb6b5547c..fe4eaee612d 100644
--- a/arch/wasm/include/asm/kw_emu.h
+++ b/arch/wasm/include/asm/kw_emu.h
@@ -35,6 +35,15 @@
  *    the icache. (Rewriting a currently mapped exec page in place with no
  *    flush at all may keep running the old code until one of those, as an
  *    incoherent icache would.)
+ *
+ * Several CPUs (ABI 7): an SMP kernel gives each CPU its own struct
+ * kw_cpu, used only by that CPU's thread, on one shared memory. kwemu
+ * built with wasm atomics (zig build -Dkwemu-atomics) makes guest AMOs
+ * atomic read-modify-writes, SC a compare-and-swap against the value LR
+ * read, and FENCE a full barrier; without atomics they assume one hart.
+ * Guest stores are tracked only by the struct kw_cpu that runs them: code
+ * another CPU rewrites is seen after a flush on this one (riscv's
+ * flush_icache syscall, FENCE.I alone is local), as on hardware.
  */
 #ifndef KW_EMU_H
 #define KW_EMU_H
@@ -49,7 +58,7 @@
 extern "C" {
 #endif
 
-#define KW_ABI_VERSION 6
+#define KW_ABI_VERSION 7
 
 struct kw_regs {
 	uint64_t x[32];   /* x[0] is ignored and reads as zero */
diff --git a/arch/wasm/include/asm/kwcpu.h b/arch/wasm/include/asm/kwcpu.h
new file mode 100644
index 00000000000..f245df77cb8
--- /dev/null
+++ b/arch/wasm/include/asm/kwcpu.h
@@ -0,0 +1,23 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * The kwemu software CPU of the running CPU (arch/wasm/mm/tlb.c), and the
+ * word of pending interrupts it polls (asm/irq.h).
+ */
+
+#ifndef _ASM_WASM_KWCPU_H
+#define _ASM_WASM_KWCPU_H
+
+#include <linux/smp.h>
+#include <asm/kw_emu.h>
+
+#ifdef CONFIG_SMP
+/* CPU 0's is static (tlb.c); the others' come from memblock (setup.c). */
+extern struct kw_cpu *kw_cpus[NR_CPUS];
+#define wasm_kw_cpu (kw_cpus[raw_smp_processor_id()])
+/* A secondary CPU sets up its kwemu (tlb.c). */
+void kw_cpu_start(void);
+#else
+extern struct kw_cpu *const wasm_kw_cpu;
+#endif
+
+#endif /* _ASM_WASM_KWCPU_H */
