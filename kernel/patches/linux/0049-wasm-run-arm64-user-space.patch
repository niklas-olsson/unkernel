diff --git a/arch/wasm/Kconfig b/arch/wasm/Kconfig
index 27dd1dde5cd..b8754207352 100644
--- a/arch/wasm/Kconfig
+++ b/arch/wasm/Kconfig
@@ -5,17 +5,22 @@ menu "Wasm-specific options"
 #
 # Execution model (unkernel): the kernel is a single Wasm instance running
 # on one host thread. Kernel tasks are separate Wasm stacks switched with JSPI
-# (JavaScript Promise Integration). User mode is not Wasm: unmodified riscv64
-# Linux ELF programs run on a software CPU ("kwemu", see include/kw_emu.h in
-# the unkernel repository) that walks the kernel's Sv39-format page tables.
+# (JavaScript Promise Integration). User mode is not Wasm: unmodified arm64
+# (AArch64) Linux ELF programs run on a software CPU ("kwemu", see
+# include/kw_emu.h in the unkernel repository) that walks the kernel's
+# Sv48-format page tables.
 #
 
 config WASM
 	bool
 	default y
 	select ARCH_NO_PREEMPT
-	# riscv64 user ABI: clone(flags, newsp, ptid, tls, ctid), as on riscv.
+	# arm64 user ABI: clone(flags, newsp, ptid, tls, ctid), as on arm64.
+	# arm64's other ABI selects are for compat (AArch32) or BTI/GNU
+	# property notes, which this port does not have.
 	select CLONE_BACKWARDS
+	# seccomp filters see AUDIT_ARCH_AARCH64 and arm64's syscall numbers.
+	select HAVE_ARCH_SECCOMP_FILTER
 	select HAVE_VIRT_CPU_ACCOUNTING_GEN
 	select HAVE_CONTEXT_TRACKING_USER
 
@@ -40,7 +45,7 @@ config WASM
 	select ARCH_USE_QUEUED_RWLOCKS if SMP
 	select ARCH_TASKS_STAY_ON_CPU if SMP
 
-# riscv64 ELF userspace runs on the kwemu software CPU with real page tables
+# arm64 ELF userspace runs on the kwemu software CPU with real page tables
 # (fork, mmap, copy-on-write). The original linux-wasm NOMMU mode (programs
 # as Wasm modules) is not supported by this port.
 config MMU
@@ -107,6 +112,6 @@ config ARCH_MMAP_RND_BITS_MAX
 
 config PGTABLE_LEVELS
 	int
-	default 3
+	default 4
 
 endmenu
