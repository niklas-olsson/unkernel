diff --git a/arch/wasm/kernel/sys.c b/arch/wasm/kernel/sys.c
new file mode 100644
index 00000000000..f72cbd38461
--- /dev/null
+++ b/arch/wasm/kernel/sys.c
@@ -0,0 +1,27 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * The arm64 system calls with an arch-specific implementation, as user
+ * mode sees them. Based on arch/arm64/kernel/sys.c.
+ */
+
+#include <linux/mm.h>
+#include <linux/personality.h>
+#include <linux/syscalls.h>
+
+SYSCALL_DEFINE6(mmap, unsigned long, addr, unsigned long, len,
+		unsigned long, prot, unsigned long, flags,
+		unsigned long, fd, unsigned long, off)
+{
+	if (offset_in_page(off) != 0)
+		return -EINVAL;
+
+	return ksys_mmap_pgoff(addr, len, prot, flags, fd, off >> PAGE_SHIFT);
+}
+
+/* There is no AArch32 at EL0 (syscall_table.c maps personality here). */
+SYSCALL_DEFINE1(arm64_personality, unsigned int, personality)
+{
+	if (personality(personality) == PER_LINUX32)
+		return -EINVAL;
+	return ksys_personality(personality);
+}
