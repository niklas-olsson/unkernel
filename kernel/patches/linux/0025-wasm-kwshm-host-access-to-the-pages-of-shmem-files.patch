@@ -0,0 +1,648 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * kwshm: the JavaScript host (unkernel) reads and writes the pages of guest
+ * shmem files in place.
+ *
+ * Copyright (C) 2026 Pooya Parsa <pooya@pi0.io>
+ *
+ * Guest programs share bulk data through ordinary shmem (shm_open(),
+ * memfd_create(), Wayland wl_shm pools). The kernel runs in the direct map
+ * (virtual == physical == Wasm linear address), so those pages already lie
+ * in memory the host can see; all the host lacks is which pages a file
+ * occupies. This driver tells it, and holds the pages while the host may
+ * look at them. The guest side stays standard: no allocator, no library.
+ *
+ * An export is a page-aligned range of a shmem file (usually all of it).
+ * Its pages are pinned with memfd_pin_folios(), the udmabuf interface:
+ * FOLL_PIN, with FOLL_LONGTERM semantics, which also allocates the holes
+ * (so every page the host sees belongs to the file, and the host writes
+ * where the guest reads). A pinned folio cannot be migrated (compaction's
+ * folio_ref_freeze() fails on the extra references, and
+ * folio_maybe_dma_pinned() lets it skip the folio early) and is not freed
+ * while pinned, even after a truncation removes it from the file. So the
+ * host never touches a page the kernel freed or reused; it may see a stale
+ * one, which it can learn with a check or fix with a refresh.
+ *
+ * Exports are announced to the host as they are made, refreshed and
+ * released: wasm_driver_shm_attach() hands over the page list (the host
+ * copies it during the call), wasm_driver_shm_detach() withdraws it, and the
+ * pages are unpinned only after that returns. Everything runs on the
+ * kernel's own thread, so the host's view changes atomically with the pins.
+ *
+ * Two ways to make one:
+ *  - By name, from the host: the host queues requests (open or create a
+ *    file in /dev/shm, refresh, check, close) and raises WASM_IRQ_SHM; a
+ *    work item takes them with wasm_driver_shm_request() and answers each
+ *    with wasm_driver_shm_reply(). Names are single path components; the
+ *    lookup runs with init's fs (scoped_with_init_fs(): a kworker's own
+ *    root is nullfs), and only regular shmem files are accepted.
+ *  - By fd, from the guest: ioctl KWSHM_IOC_EXPORT on /dev/kwshm
+ *    (include/uapi/linux/kwshm.h) returns an id that a guest program sends
+ *    to the host; the export dies with KWSHM_IOC_RELEASE or with the
+ *    /dev/kwshm file that made it.
+ *
+ * Present only when the host offers it: wasm_driver_shm_init() < 0 means
+ * no device, and then nothing is registered or allocated. No import here
+ * suspends.
+ */
+
+#include <linux/fcntl.h>
+#include <linux/file.h>
+#include <linux/fs.h>
+#include <linux/fs_struct.h>
+#include <linux/idr.h>
+#include <linux/init.h>
+#include <linux/interrupt.h>
+#include <linux/kwshm.h>
+#include <linux/magic.h>
+#include <linux/memfd.h>
+#include <linux/miscdevice.h>
+#include <linux/mm.h>
+#include <linux/mutex.h>
+#include <linux/namei.h>
+#include <linux/shmem_fs.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+#include <linux/workqueue.h>
+#include <asm/irq.h>
+#include <asm/wasm.h>
+
+#define KWSHM_DIR		"/dev/shm"
+#define KWSHM_MAX_EXPORTS	4096
+/* Host requests handled per run of the work item before it yields. */
+#define KWSHM_REQ_BATCH		16
+
+/* Host requests (struct kwshm_req.op). */
+#define KWSHM_OP_OPEN		1	/* name -> id */
+#define KWSHM_OP_CREATE		2	/* name, size, mode (flags) -> id */
+#define KWSHM_OP_REFRESH	3	/* id, flags -> 0 unchanged, 1 new page list */
+#define KWSHM_OP_CHECK		4	/* id -> 0 current, 1 stale */
+#define KWSHM_OP_CLOSE		5	/* id (made by the host) -> 0 */
+
+/* KWSHM_OP_REFRESH flags: re-pin and announce even if nothing changed. */
+#define KWSHM_REFRESH_FORCE	1
+
+/* wasm_driver_shm_attach() flags. */
+#define KWSHM_HOST_WRITABLE	(1U << 0)	/* the host may write */
+#define KWSHM_HOST_GUEST	(1U << 1)	/* made by the guest (KWSHM_IOC_EXPORT) */
+
+/* A host request, as wasm_driver_shm_request() copies it (little endian). */
+struct kwshm_req {
+	u32 op;
+	u32 tag;			/* echoed in wasm_driver_shm_reply() */
+	u32 id;				/* REFRESH, CHECK, CLOSE */
+	u32 flags;			/* REFRESH: KWSHM_REFRESH_*; CREATE: the mode */
+	u64 size;			/* CREATE */
+	char name[NAME_MAX + 1];	/* OPEN, CREATE: one component, NUL-terminated */
+};
+
+/* Host imports, module "unkernel" (js/core/shm.ts). None of them suspends. */
+/* Offer the device; @req_size is sizeof(struct kwshm_req). < 0: none. */
+int wasm_driver_shm_init(u32 req_size)
+	__unkernel_import(wasm_driver_shm_init);
+/* Copy the next queued request into @buf (at most @max bytes) and dequeue it; 0: none. */
+u32 wasm_driver_shm_request(void *buf, u32 max)
+	__unkernel_import(wasm_driver_shm_request);
+/*
+ * Export @id now covers @size bytes in @npages pages, whose linear
+ * addresses are @pages (copied during the call); @gen counts its page
+ * lists. Replaces any earlier list of @id.
+ */
+void wasm_driver_shm_attach(u32 id, u32 flags, u32 gen, u64 size,
+			    const u32 *pages, u32 npages)
+	__unkernel_import(wasm_driver_shm_attach);
+/* Export @id is gone: the host must drop its pages before returning. */
+void wasm_driver_shm_detach(u32 id)
+	__unkernel_import(wasm_driver_shm_detach);
+/* The answer to request @tag: >= 0 as the op says, or -errno. */
+void wasm_driver_shm_reply(u32 tag, int result)
+	__unkernel_import(wasm_driver_shm_reply);
+
+/* Pinned folios covering @size bytes of a file. */
+struct kwshm_pins {
+	struct folio **folios;
+	unsigned int nr;		/* folios */
+	size_t first;			/* byte offset of the range in folios[0] */
+	unsigned long npages;
+	u64 size;
+};
+
+/* A /dev/kwshm file. */
+struct kwshm_client {
+	struct list_head exports;
+};
+
+struct kwshm_export_rec {
+	u32 id;
+	u32 flags;			/* KWSHM_HOST_* */
+	u32 gen;
+	struct file *file;
+	struct kwshm_client *owner;	/* NULL: the host's */
+	struct list_head node;		/* in owner->exports */
+	loff_t start;
+	u64 want;			/* bytes asked for; 0: to the end of the file */
+	struct kwshm_pins pins;
+};
+
+static DEFINE_MUTEX(kwshm_lock);	/* everything below */
+static DEFINE_IDR(kwshm_ids);
+static unsigned int kwshm_count;
+static unsigned long kwshm_pinned, kwshm_pin_limit;
+static struct work_struct kwshm_work;
+static struct kwshm_req kwshm_reqbuf;	/* only kwshm_work_fn uses it */
+
+static int kwshm_pin(struct file *file, loff_t start, u64 size,
+		     struct kwshm_pins *p)
+{
+	unsigned long npages = DIV_ROUND_UP(size, PAGE_SIZE), have = 0;
+	pgoff_t first;
+	long n, i;
+
+	memset(p, 0, sizeof(*p));
+	if (!size)
+		return 0;
+	if (npages > UINT_MAX || kwshm_pinned + npages > kwshm_pin_limit)
+		return -ENOMEM;
+	p->folios = kvmalloc_array(npages, sizeof(*p->folios), GFP_KERNEL);
+	if (!p->folios)
+		return -ENOMEM;
+	/* Allocates the holes; fails if the file is now shorter. */
+	n = memfd_pin_folios(file, start, start + size - 1, p->folios, npages,
+			     &first);
+	if (n < 0) {
+		kvfree(p->folios);
+		p->folios = NULL;
+		return n;
+	}
+	for (i = 0; i < n; i++)
+		have += folio_nr_pages(p->folios[i]) - (i ? 0 : first >> PAGE_SHIFT);
+	if (have < npages) {
+		/* Truncated under us. */
+		unpin_folios(p->folios, n);
+		kvfree(p->folios);
+		p->folios = NULL;
+		return -EAGAIN;
+	}
+	p->nr = n;
+	p->first = first;
+	p->npages = npages;
+	p->size = size;
+	kwshm_pinned += npages;
+	return 0;
+}
+
+static void kwshm_unpin(struct kwshm_pins *p, bool dirty)
+{
+	unsigned int i;
+
+	if (!p->folios)
+		return;
+	/* The host may have written them (as unpin_user_pages_dirty_lock()). */
+	for (i = 0; dirty && i < p->nr; i++)
+		folio_mark_dirty_lock(p->folios[i]);
+	unpin_folios(p->folios, p->nr);
+	kvfree(p->folios);
+	kwshm_pinned -= p->npages;
+	memset(p, 0, sizeof(*p));
+}
+
+/* Bytes the export should cover now. */
+static u64 kwshm_cover(struct kwshm_export_rec *e)
+{
+	loff_t isize = i_size_read(file_inode(e->file));
+	u64 avail = isize > e->start ? isize - e->start : 0;
+
+	return e->want ? min(e->want, avail) : avail;
+}
+
+/*
+ * Has the file moved away from the held pages: another size, or a held
+ * folio no longer in the file at its place (a truncation or hole punch
+ * removes it from the page cache, which clears folio->mapping)?
+ */
+static bool kwshm_stale(struct kwshm_export_rec *e)
+{
+	pgoff_t idx = e->start >> PAGE_SHIFT;
+	unsigned int i;
+
+	if (kwshm_cover(e) != e->pins.size)
+		return true;
+	for (i = 0; i < e->pins.nr; i++) {
+		struct folio *f = e->pins.folios[i];
+		pgoff_t off = i ? 0 : e->pins.first >> PAGE_SHIFT;
+
+		if (READ_ONCE(f->mapping) != e->file->f_mapping ||
+		    f->index + off != idx)
+			return true;
+		idx += folio_nr_pages(f) - off;
+	}
+	return false;
+}
+
+/* Tell the host where @e's pages are now. */
+static int kwshm_attach(struct kwshm_export_rec *e, struct kwshm_pins *p)
+{
+	unsigned long k = 0, j;
+	unsigned int i;
+	u32 *tab = NULL;
+
+	if (p->npages) {
+		tab = kvmalloc_array(p->npages, sizeof(*tab), GFP_KERNEL);
+		if (!tab)
+			return -ENOMEM;
+	}
+	for (i = 0; i < p->nr && k < p->npages; i++) {
+		struct folio *f = p->folios[i];
+
+		for (j = i ? 0 : p->first >> PAGE_SHIFT;
+		     j < folio_nr_pages(f) && k < p->npages; j++)
+			/* Guest RAM is below 4 GiB (the lowered build relies on it too). */
+			tab[k++] = (u32)(unsigned long)folio_address(f) + (j << PAGE_SHIFT);
+	}
+	wasm_driver_shm_attach(e->id, e->flags, e->gen, p->size, tab, k);
+	kvfree(tab);
+	return 0;
+}
+
+/* Make an export of @file (the caller keeps its own reference). */
+static struct kwshm_export_rec *kwshm_new(struct file *file, loff_t start,
+					  u64 want, u32 flags,
+					  struct kwshm_client *owner)
+{
+	struct kwshm_export_rec *e;
+	loff_t isize = i_size_read(file_inode(file));
+	int err, id;
+
+	if (start < 0 || (start & ~PAGE_MASK) || start > isize ||
+	    (want && want > isize - start))
+		return ERR_PTR(-EINVAL);
+	if (kwshm_count >= KWSHM_MAX_EXPORTS)
+		return ERR_PTR(-ENOSPC);
+	e = kzalloc(sizeof(*e), GFP_KERNEL);
+	if (!e)
+		return ERR_PTR(-ENOMEM);
+	e->file = get_file(file);
+	e->start = start;
+	e->want = want;
+	e->flags = flags;
+	e->owner = owner;
+	e->gen = 1;
+	err = kwshm_pin(file, start, kwshm_cover(e), &e->pins);
+	if (err)
+		goto err_free;
+	id = idr_alloc_cyclic(&kwshm_ids, e, 1, INT_MAX, GFP_KERNEL);
+	if (id < 0) {
+		err = id;
+		goto err_unpin;
+	}
+	e->id = id;
+	err = kwshm_attach(e, &e->pins);
+	if (err)
+		goto err_id;
+	if (owner)
+		list_add_tail(&e->node, &owner->exports);
+	kwshm_count++;
+	return e;
+
+err_id:
+	idr_remove(&kwshm_ids, e->id);
+err_unpin:
+	kwshm_unpin(&e->pins, false);
+err_free:
+	fput(e->file);
+	kfree(e);
+	return ERR_PTR(err);
+}
+
+static void kwshm_drop(struct kwshm_export_rec *e)
+{
+	wasm_driver_shm_detach(e->id);	/* the host lets go first */
+	idr_remove(&kwshm_ids, e->id);
+	if (e->owner)
+		list_del(&e->node);
+	kwshm_unpin(&e->pins, e->flags & KWSHM_HOST_WRITABLE);
+	fput(e->file);
+	kfree(e);
+	kwshm_count--;
+}
+
+/* 0: still current (nothing done); 1: a new page list was announced. */
+static int kwshm_refresh(struct kwshm_export_rec *e, bool force)
+{
+	struct kwshm_pins p;
+	int err;
+
+	if (!force && !kwshm_stale(e))
+		return 0;
+	err = kwshm_pin(e->file, e->start, kwshm_cover(e), &p);
+	if (err)
+		return err;
+	e->gen++;
+	err = kwshm_attach(e, &p);
+	if (err) {
+		e->gen--;
+		kwshm_unpin(&p, false);
+		return err;
+	}
+	/* The host has the new list; only now let the old pages go. */
+	kwshm_unpin(&e->pins, e->flags & KWSHM_HOST_WRITABLE);
+	e->pins = p;
+	return 1;
+}
+
+static struct file *__kwshm_open_name(const char *name, bool create, umode_t mode,
+				    u64 size, u32 *flags)
+{
+	struct file *f;
+	struct path path;
+	char *full;
+	int err;
+
+	if (!name[0] || !strcmp(name, ".") || !strcmp(name, "..") || strchr(name, '/'))
+		return ERR_PTR(-EINVAL);
+	full = kasprintf(GFP_KERNEL, KWSHM_DIR "/%s", name);
+	if (!full)
+		return ERR_PTR(-ENOMEM);
+	*flags = KWSHM_HOST_WRITABLE;
+	if (create) {
+		err = kern_path(KWSHM_DIR, LOOKUP_FOLLOW | LOOKUP_DIRECTORY, &path);
+		if (!err) {
+			if (path.dentry->d_sb->s_magic != TMPFS_MAGIC)
+				err = -EOPNOTSUPP;
+			path_put(&path);
+		}
+		if (err) {
+			f = ERR_PTR(err);
+			goto out;
+		}
+		f = filp_open(full, O_RDWR | O_CREAT | O_EXCL | O_NOFOLLOW | O_LARGEFILE,
+			      mode & 0777);
+		if (IS_ERR(f))
+			goto out;
+		err = vfs_truncate(&f->f_path, size);
+		if (err) {
+			fput(f);
+			f = ERR_PTR(err);
+		}
+		goto check;
+	}
+	/* No LOOKUP_FOLLOW: a symlink is looked at, not through. */
+	err = kern_path(full, 0, &path);
+	if (err) {
+		f = ERR_PTR(err);
+		goto out;
+	}
+	if (d_is_dir(path.dentry))
+		err = -EISDIR;
+	else if (!d_is_reg(path.dentry))
+		err = -EINVAL;
+	else if (!shmem_mapping(d_inode(path.dentry)->i_mapping))
+		err = -EOPNOTSUPP;
+	if (err) {
+		path_put(&path);
+		f = ERR_PTR(err);
+		goto out;
+	}
+	f = dentry_open(&path, O_RDWR | O_LARGEFILE, current_cred());
+	if (IS_ERR(f) && (PTR_ERR(f) == -EROFS || PTR_ERR(f) == -EACCES ||
+			  PTR_ERR(f) == -EPERM || PTR_ERR(f) == -ETXTBSY)) {
+		f = dentry_open(&path, O_RDONLY | O_LARGEFILE, current_cred());
+		*flags = 0;
+	}
+	path_put(&path);
+check:
+	if (!IS_ERR(f) && !shmem_file(f)) {
+		fput(f);
+		f = ERR_PTR(-EOPNOTSUPP);
+	}
+out:
+	kfree(full);
+	return f;
+}
+
+/*
+ * A regular shmem file in /dev/shm, opened (or created) for the host. Called
+ * from a work item, whose fs is rooted at nullfs: resolve in init's.
+ */
+static struct file *kwshm_open_name(const char *name, bool create, umode_t mode,
+				    u64 size, u32 *flags)
+{
+	struct file *f = ERR_PTR(-ENOENT);
+
+	scoped_with_init_fs()
+		f = __kwshm_open_name(name, create, mode, size, flags);
+	return f;
+}
+
+static int kwshm_host_open(struct kwshm_req *r, bool create)
+{
+	struct kwshm_export_rec *e;
+	struct file *f;
+	u32 flags;
+
+	if (create && r->size > MAX_LFS_FILESIZE)
+		return -EFBIG;
+	f = kwshm_open_name(r->name, create, create ? r->flags : 0, r->size, &flags);
+	if (IS_ERR(f))
+		return PTR_ERR(f);
+	e = kwshm_new(f, 0, 0, flags, NULL);
+	fput(f);
+	return IS_ERR(e) ? PTR_ERR(e) : e->id;
+}
+
+static int kwshm_handle(struct kwshm_req *r)
+{
+	struct kwshm_export_rec *e = NULL;
+
+	switch (r->op) {
+	case KWSHM_OP_OPEN:
+		return kwshm_host_open(r, false);
+	case KWSHM_OP_CREATE:
+		return kwshm_host_open(r, true);
+	case KWSHM_OP_REFRESH:
+	case KWSHM_OP_CHECK:
+	case KWSHM_OP_CLOSE:
+		e = idr_find(&kwshm_ids, r->id);
+		if (!e)
+			return -ENOENT;
+		break;
+	default:
+		return -EINVAL;
+	}
+	if (r->op == KWSHM_OP_REFRESH)
+		return kwshm_refresh(e, r->flags & KWSHM_REFRESH_FORCE);
+	if (r->op == KWSHM_OP_CHECK)
+		return kwshm_stale(e);
+	if (e->owner)
+		return -EPERM;	/* the guest's: it lives until the guest releases it */
+	kwshm_drop(e);
+	return 0;
+}
+
+static void kwshm_work_fn(struct work_struct *work)
+{
+	struct kwshm_req *r = &kwshm_reqbuf;
+	int n, ret;
+
+	for (n = 0; n < KWSHM_REQ_BATCH; n++) {
+		memset(r, 0, sizeof(*r));
+		if (!wasm_driver_shm_request(r, sizeof(*r)))
+			return;
+		r->name[NAME_MAX] = 0;
+		mutex_lock(&kwshm_lock);
+		ret = kwshm_handle(r);
+		mutex_unlock(&kwshm_lock);
+		wasm_driver_shm_reply(r->tag, ret);
+	}
+	/* More may be queued: let other work run first. */
+	schedule_work(&kwshm_work);
+}
+
+static irqreturn_t kwshm_irq(int irq, void *dev_id)
+{
+	schedule_work(&kwshm_work);
+	return IRQ_HANDLED;
+}
+
+static int kwshm_open(struct inode *inode, struct file *file)
+{
+	struct kwshm_client *c = kzalloc(sizeof(*c), GFP_KERNEL);
+
+	if (!c)
+		return -ENOMEM;
+	INIT_LIST_HEAD(&c->exports);
+	file->private_data = c;
+	return 0;
+}
+
+static int kwshm_release(struct inode *inode, struct file *file)
+{
+	struct kwshm_client *c = file->private_data;
+	struct kwshm_export_rec *e, *tmp;
+
+	mutex_lock(&kwshm_lock);
+	list_for_each_entry_safe(e, tmp, &c->exports, node)
+		kwshm_drop(e);
+	mutex_unlock(&kwshm_lock);
+	kfree(c);
+	return 0;
+}
+
+static long kwshm_export_fd(struct kwshm_client *c, struct kwshm_export *a)
+{
+	CLASS(fd, fd)(a->fd);
+	struct kwshm_export_rec *e;
+	u32 flags = KWSHM_HOST_GUEST;
+	struct file *f;
+	long seals;
+
+	if (fd_empty(fd))
+		return -EBADF;
+	f = fd_file(fd);
+	if (!shmem_file(f) || !S_ISREG(file_inode(f)->i_mode))
+		return -EINVAL;
+	if (!(f->f_mode & FMODE_READ))
+		return -EACCES;
+	if ((f->f_mode & FMODE_WRITE) && !(a->flags & KWSHM_EXPORT_RDONLY)) {
+		/* -EINVAL: no seals (a /dev/shm file) */
+		seals = memfd_fcntl(f, F_GET_SEALS, 0);
+		if (seals < 0 || !(seals & (F_SEAL_WRITE | F_SEAL_FUTURE_WRITE)))
+			flags |= KWSHM_HOST_WRITABLE;
+	}
+	e = kwshm_new(f, a->offset, a->length, flags, c);
+	if (IS_ERR(e))
+		return PTR_ERR(e);
+	a->size = e->pins.size;
+	a->id = e->id;
+	a->pages = e->pins.npages;
+	return 0;
+}
+
+static long kwshm_export(struct kwshm_client *c, struct kwshm_export __user *uarg)
+{
+	struct kwshm_export a;
+	struct kwshm_export_rec *e;
+	long ret;
+
+	if (copy_from_user(&a, uarg, sizeof(a)))
+		return -EFAULT;
+	if (a.flags & ~KWSHM_EXPORT_RDONLY ||
+	    a.offset > MAX_LFS_FILESIZE || a.length > MAX_LFS_FILESIZE)
+		return -EINVAL;
+	mutex_lock(&kwshm_lock);
+	ret = kwshm_export_fd(c, &a);
+	if (!ret && copy_to_user(uarg, &a, sizeof(a))) {
+		e = idr_find(&kwshm_ids, a.id);
+		if (e)
+			kwshm_drop(e);
+		ret = -EFAULT;
+	}
+	mutex_unlock(&kwshm_lock);
+	return ret;
+}
+
+static long kwshm_ioctl(struct file *file, unsigned int cmd, unsigned long arg)
+{
+	struct kwshm_client *c = file->private_data;
+	struct kwshm_export_rec *e;
+	long ret = 0;
+	u32 id;
+
+	switch (cmd) {
+	case KWSHM_IOC_EXPORT:
+		return kwshm_export(c, (struct kwshm_export __user *)arg);
+	case KWSHM_IOC_RELEASE:
+		if (get_user(id, (u32 __user *)arg))
+			return -EFAULT;
+		mutex_lock(&kwshm_lock);
+		e = id ? idr_find(&kwshm_ids, id) : NULL;
+		if (e && e->owner == c)
+			kwshm_drop(e);
+		else
+			ret = -ENOENT;
+		mutex_unlock(&kwshm_lock);
+		return ret;
+	}
+	return -ENOTTY;
+}
+
+static const struct file_operations kwshm_fops = {
+	.owner		= THIS_MODULE,
+	.open		= kwshm_open,
+	.release	= kwshm_release,
+	.unlocked_ioctl	= kwshm_ioctl,
+	.llseek		= noop_llseek,
+};
+
+static struct miscdevice kwshm_misc = {
+	.minor	= MISC_DYNAMIC_MINOR,
+	.name	= "kwshm",
+	.fops	= &kwshm_fops,
+	.mode	= 0666,
+};
+
+static int __init kwshm_init(void)
+{
+	int err;
+
+	if (wasm_driver_shm_init(sizeof(struct kwshm_req)) < 0) {
+		pr_info("kwshm: no host shm\n");
+		return 0;
+	}
+	/* Held pages, including truncated ones still held: at most half of RAM. */
+	kwshm_pin_limit = totalram_pages() / 2;
+	INIT_WORK(&kwshm_work, kwshm_work_fn);
+	err = request_irq(WASM_IRQ_SHM, kwshm_irq, 0, "kwshm", &kwshm_work);
+	if (err)
+		return err;
+	err = misc_register(&kwshm_misc);
+	if (err) {
+		free_irq(WASM_IRQ_SHM, &kwshm_work);
+		return err;
+	}
+	pr_info("kwshm: host shm, /dev/kwshm\n");
+	/* Requests may have been queued before the handler existed. */
+	schedule_work(&kwshm_work);
+	return 0;
+}
+device_initcall(kwshm_init);
