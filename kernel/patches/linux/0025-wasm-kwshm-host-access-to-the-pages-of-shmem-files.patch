--- /dev/null
+++ b/include/uapi/linux/kwshm.h
@@ -0,0 +1,44 @@
+/* SPDX-License-Identifier: GPL-2.0-only WITH Linux-syscall-note */
+/*
+ * kwshm: let the JavaScript host of a unkernel instance read and write the
+ * pages of a shmem file (a memfd or a file in /dev/shm) in place.
+ *
+ * Copyright (C) 2026 Pooya Parsa <pooya@pi0.io>
+ *
+ * /dev/kwshm, ioctl KWSHM_IOC_EXPORT: hand a shmem file descriptor (or a
+ * page-aligned range of it) to the host. The kernel holds its pages and
+ * tells the host where they are; the returned id is what a guest program
+ * sends to the host over any channel (vsock, the console, ...). An export
+ * lives until KWSHM_IOC_RELEASE or until the /dev/kwshm file that made it
+ * is closed. Holes are allocated on export, so every exported page is the
+ * file's. Pages that a later truncation removes from the file stay held
+ * (and the host sees them, stale) until the export is refreshed or
+ * released.
+ */
+#ifndef _UAPI_LINUX_KWSHM_H
+#define _UAPI_LINUX_KWSHM_H
+
+#include <linux/ioctl.h>
+#include <linux/types.h>
+
+/* struct kwshm_export flags. */
+#define KWSHM_EXPORT_RDONLY	(1U << 0)	/* the host may only read */
+
+struct kwshm_export {
+	__s32 fd;	/* in: a shmem file (memfd, /dev/shm), open for reading */
+	__u32 flags;	/* in: KWSHM_EXPORT_* */
+	__u64 offset;	/* in: start in the file, page aligned */
+	__u64 length;	/* in: bytes, within the file; 0: to the end of the file,
+			 * following its size when the host refreshes */
+	__u64 size;	/* out: bytes exported */
+	__u32 id;	/* out: the export's id, > 0 */
+	__u32 pages;	/* out: pages held */
+};
+
+#define KWSHM_IOC_MAGIC		0xBB
+/* Export a shmem fd; fills size, id and pages. */
+#define KWSHM_IOC_EXPORT	_IOWR(KWSHM_IOC_MAGIC, 0x00, struct kwshm_export)
+/* Release an export this file made (the argument is its id). */
+#define KWSHM_IOC_RELEASE	_IOW(KWSHM_IOC_MAGIC, 0x01, __u32)
+
+#endif /* _UAPI_LINUX_KWSHM_H */
