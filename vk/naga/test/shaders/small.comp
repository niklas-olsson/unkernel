// 8/16-bit storage as llama.cpp uses it: q4_0 blocks (18 bytes: float16_t +
// uint8_t[16]) read through a second, packed16 view of the same binding,
// int8 unpacking, float16_t stores (KV cache style) next to f32 stores.
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
layout(local_size_x = 64) in;
struct block_q4_0 { float16_t d; uint8_t qs[16]; };
struct block_q4_0_packed16 { float16_t d; uint16_t qs[8]; };
layout(std430, binding = 0) readonly buffer A { block_q4_0 a[]; };
layout(std430, binding = 0) readonly buffer A16 { block_q4_0_packed16 a16[]; };
layout(std430, binding = 1) writeonly buffer D { float16_t d[]; };
layout(std430, binding = 2) buffer E { float e[]; } eb;
layout(std430, binding = 3) readonly buffer Q { int8_t q[]; } qb;
void main() {
	uint i = gl_GlobalInvocationID.x;
	uint b = i / 32u, j = i % 16u;
	float lo = float(int(a[b].qs[j] & uint8_t(15)) - 8);
	uint16_t p = a16[b].qs[j / 2u];
	float v = float(a[b].d) * lo + float(p >> 8);
	d[i] = float16_t(v);
	eb.e[i] = v + float(qb.q[i]);
}
