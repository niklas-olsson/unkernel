// A compute shader over a runtime-sized storage buffer.
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer In { float values[]; } src;
layout(std430, binding = 1) buffer Out { float values[]; } dst;
void main() {
	uint i = gl_GlobalInvocationID.x;
	if (i < src.values.length()) dst.values[i] = src.values[i] * 2.0;
}
