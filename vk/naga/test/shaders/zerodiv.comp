// llama.cpp's mul_mm a_shmem_index: with its specialization (TK = 1, no
// reshape) a dead branch divides by TK / 2 = 0. Vulkan allows it; naga
// and Tint refuse a constant zero divisor, so the translator removes it.
layout(constant_id = 0) const uint TK = 1;
layout(constant_id = 1) const bool RESHAPE = false;
layout(std430, set = 0, binding = 0) buffer O { uint o[]; };
layout(local_size_x = 4) in;
uint idx(uint m, uint k) {
	if (RESHAPE) {
		const uint w = TK / 2;
		return (k / w) * 64u + m * w + k % w;
	}
	return m * 8u + k;
}
uint vec_part(uint i) {
	if (RESHAPE) {
		ivec2 v = ivec2(int(i), 5);
		ivec2 q = v / ivec2(int(TK / 2));
		return uint(q.x + v.y % int(TK / 2));
	}
	return i;
}
void main() {
	uint i = gl_GlobalInvocationID.x;
	o[i] = idx(i, 3u);
	o[i + 4u] = vec_part(i);
}
