// llama.cpp patterns: umulExtended (fastdiv), a std430 push constant array,
// an infinite seed, spec-constant expressions on gl_WorkGroupSize.
layout(local_size_x_id = 0) in;
layout(constant_id = 0) const uint BLOCK = 64;
const uint HALF = gl_WorkGroupSize.x / 2u;
layout(push_constant) uniform P { uint ne[4]; uint mp; uint l; } p;
layout(std430, binding = 0) buffer D { float d[]; } data;
shared float red[HALF];
uint fastdiv(uint n, uint mp, uint l) {
	uint msbs, lsbs;
	umulExtended(n, mp, msbs, lsbs);
	return (msbs + n) >> l;
}
void main() {
	uint i = gl_GlobalInvocationID.x;
	float m = -1.0 / 0.0;
	if (i < p.ne[0]) m = max(m, data.d[i]);
	red[gl_LocalInvocationID.x % HALF] = m;
	data.d[i] = float(fastdiv(i, p.mp, p.l)) + red[0];
}
