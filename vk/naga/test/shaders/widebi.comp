// A 512-wide workgroup reading local/workgroup ids, the local index and
// the workgroup count (ggml's get_rows/norm style, without barriers).
layout(local_size_x = 512) in;
layout(set = 0, binding = 0) buffer B { uint v[]; } b;
void main() {
	uint g = gl_GlobalInvocationID.x;
	b.v[g * 4u] = gl_LocalInvocationID.x;
	b.v[g * 4u + 1u] = gl_WorkGroupID.x;
	b.v[g * 4u + 2u] = gl_LocalInvocationIndex;
	b.v[g * 4u + 3u] = gl_NumWorkGroups.x;
}
