// A std430 push block WGSL's uniform address space cannot lay out (arrays
// of stride 4 and 8, a struct of 4-byte alignment, a non-square row-major
// matrix): repacked into vec4<u32> words (uniform.rs). run.ts dispatches it
// with known bytes and compares every output.
struct Inner {
	float x;
	uint y[3];
};
layout(push_constant) uniform P {
	uint n;                   // 0
	float c[2];               // 4
	int s[4];                 // 12
	vec3 v;                   // 32
	float w;                  // 44
	Inner q;                  // 48
	vec2 uv[2];               // 64
	mat2 m;                   // 80
	layout(row_major) mat2x3 rm; // 96
} p;
layout(std430, set = 0, binding = 0) writeonly buffer O { float o[]; };
layout(local_size_x = 4) in;
void main() {
	uint i = gl_GlobalInvocationID.x;
	uint b = i * 16u;
	o[b + 0u] = float(p.n);
	o[b + 1u] = p.c[i % 2u];
	o[b + 2u] = float(p.s[i]);
	o[b + 3u] = p.v[i % 3u];
	o[b + 4u] = p.w;
	Inner q = p.q;
	o[b + 5u] = q.x + float(q.y[i % 3u]);
	o[b + 6u] = p.uv[i % 2u].y;
	o[b + 7u] = p.m[i % 2u][1u - i % 2u];
	vec2 mv = p.m * vec2(1.0, 2.0);
	o[b + 8u] = mv.x;
	o[b + 9u] = mv.y;
	o[b + 10u] = p.c[0] + p.c[1];
	o[b + 11u] = p.rm[i % 2u][i % 3u];
	vec3 rv = p.rm * vec2(1.0, 1.0);
	o[b + 12u] = rv.x;
	o[b + 13u] = rv.y;
	o[b + 14u] = rv.z;
	o[b + 15u] = float(p.s[3u - i]);
}
